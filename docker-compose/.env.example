# Copy to .env and fill in any secrets your provider requires.
# GitHub Copilot does not use OPENAI_API_KEY; use the authenticated GitHub Copilot flow instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_COPILOT_API_BASE=https://api.githubcopilot.com
GENAI_PROVIDER=copilot
OPENAI_API_BASE=https://api.openai.com
ANTHROPIC_API_BASE=https://api.anthropic.com
NOTARYMIND_OCR_MODEL=github-copilot/claude-opus-4.8
NOTARYMIND_REINTERPRET_MODEL=gpt-4o-mini
NOTARYMIND_MAP_MODEL=gpt-4o-mini
PORT=8787
