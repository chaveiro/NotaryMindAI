<!doctype html>
<html lang="pt"><head><meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>NotaryMind AI - Explorador de Certidões, Relações e Propriedades</title>
<style>
  #archiveName{cursor:help;font-weight:500;border-bottom:1px dotted #64748b;position:relative}
  :root{--bg:#f1f5f9;--pan:#ffffff;--ink:#0f172a;--mut:#475569;--line:#cbd5e1}
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{font-family:system-ui,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink);display:flex;flex-direction:column;height:100vh}
  header{padding:10px 16px;background:#0f172a;color:#fff;flex:0 0 auto;position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
  header h1{margin:0;font-size:16px} header p{margin:2px 0 0;font-size:11px;color:#cbd5e1}
  .bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:7px 16px;background:#e2e8f0;font-size:12px;flex:0 0 auto;border-bottom:1px solid var(--line)}
  .bar .grp{display:flex;gap:6px;align-items:center}
  .bar button{font-size:12px;padding:4px 10px;border:1px solid #94a3b8;border-radius:6px;background:#fff;cursor:pointer}
  .bar button:hover{background:#f8fafc}
  .bar button.on{background:#0f172a;color:#fff;border-color:#0f172a}
  .bar label{display:flex;gap:4px;align-items:center;cursor:pointer;white-space:nowrap}
  .sw{width:12px;height:12px;border-radius:3px;display:inline-block;border:1px solid #0002}
  .sep{width:1px;height:20px;background:#94a3b8;margin:0 2px}
  .main{flex:1 1 auto;display:flex;min-height:0}
  .wrap{flex:1 1 auto;overflow:hidden;position:relative}
  svg{display:block;width:100%;height:100%;cursor:grab;touch-action:none}
  svg.panning{cursor:grabbing}
  aside{width:340px;flex:0 0 auto;background:var(--pan);border-left:1px solid var(--line);overflow:auto;padding:14px;font-size:13px;display:none}
  aside.show{display:block}
  aside h2{margin:0 0 2px;font-size:15px}
  aside .role{color:var(--mut);font-size:12px;margin-bottom:8px}
  aside h3{margin:14px 0 4px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#334155;border-bottom:1px solid var(--line);padding-bottom:2px}
  aside ul{margin:4px 0;padding-left:16px} aside li{margin:2px 0}
  aside .k{color:var(--mut)}
  aside .close{float:right;cursor:pointer;border:none;background:#e2e8f0;border-radius:6px;padding:2px 8px}
  aside .btn{margin-top:8px;font-size:12px;padding:4px 10px;border:1px solid #94a3b8;border-radius:6px;background:#fff;cursor:pointer}
  .node{cursor:grab}.node.drag{cursor:grabbing}
  .node rect,.node ellipse{stroke:#334155;stroke-width:1.4}
  .node:hover rect,.node:hover ellipse{stroke:#0ea5e9;stroke-width:2.2}
  .node.sel rect,.node.sel ellipse{stroke:#0ea5e9;stroke-width:2.6}
  .dim{opacity:.12}
  .nm{font-size:12.5px;font-weight:700;fill:#0f172a}
  .pp{font-size:9.5px;fill:#475569}.su{font-size:9px;fill:#64748b}
  .grid{stroke:#e5eaf1;stroke-width:1;stroke-dasharray:3 7}
  .hint{color:#475569}
  .empty{padding:30px;font-size:14px;color:#334155;max-width:640px;line-height:1.5}
  code{background:#e2e8f0;padding:1px 5px;border-radius:4px}
  path[data-a]{cursor:pointer}
  path.hit{cursor:pointer}
  aside a{color:#2563eb;text-decoration:none} aside a:hover{text-decoration:underline}
  aside details.docsrc{margin:3px 0;border:1px solid var(--line);border-radius:6px;padding:3px 6px}
  aside details.docsrc summary{cursor:pointer;font-size:12.5px}
  aside .srcbox{padding:4px 0 2px 10px}
  #tip{position:fixed;display:none;pointer-events:none;z-index:60;background:#0f172a;color:#fff;font-size:11px;padding:4px 8px;border-radius:6px;max-width:300px;box-shadow:0 2px 8px #0005;line-height:1.35}
  #archiveName{cursor:help;font-weight:500;border-bottom:1px dotted #64748b;position:relative}
</style></head>
<body>
<header>
  <div style="flex:1">
    <h1 style="margin:0 0 2px 0">NotaryMind AI</h1>
    <p style="margin:0;font-size:13px;color:#94a3b8;font-weight:400">Explorador de Certidões, Relações e Propriedades</p>
  </div>
  <div style="text-align:right;white-space:nowrap;display:flex;flex-direction:column;gap:2px">
    <p id="stats" style="margin:0"></p>
    <p id="sub" style="margin:0"><span id="archiveName" style="cursor:help;font-weight:500;border-bottom:1px dotted #64748b;cursor:pointer" title="clica para info"></span></p>
  </div>
</header>

<div class="bar" id="bar" style="display:none">
  <div class="grp">
    <button id="vGen" class="on">Genealogia</button>
    <button id="vProp">Propriedades</button>
    <button id="vDoc">Documentos</button>
  </div>
  <div class="sep"></div>
  <div class="grp" id="filters"></div>
  <div class="sep"></div>
  <div class="grp">
    <button id="fit" title="Ajustar Zoom">⛶</button>
    <button id="btnSource" title="Carregar JSON">⚙️</button>
    <button id="clearFocus" style="display:none">Limpar foco</button>
  </div>
  <span class="hint" id="barHint">Arraste os nós · clique para detalhes/drilldown</span>
</div>


<div id="sourceModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:3000;align-items:center;justify-content:center;flex-direction:column">
  <div style="background:#1e293b;color:#e2e8f0;padding:20px;border-radius:8px;min-width:400px;max-width:500px;box-shadow:0 4px 20px #0005">
    <h2 style="margin-top:0">Fonte de Dados</h2>
    
    <div style="margin:15px 0;font-size:12px;color:#94a3b8">
      <b>Fonte atual:</b><br>
      <code id="currentSource" style="display:block;margin-top:5px;padding:8px;background:#0f172a;border-radius:4px;word-break:break-all">documentos_logicos.json</code>
    </div>
    
    <div style="margin:15px 0">
      <label style="display:block;font-size:12px;margin-bottom:5px"><b>📥 Carregar de URL:</b></label>
      <input id="urlInput" type="text" placeholder="ex: http://localhost:8000/documentos_logicos.json" style="width:100%;padding:8px;background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:4px;box-sizing:border-box;font-size:12px">
      <button id="btnLoadUrl" style="margin-top:8px;padding:8px 12px;background:#2563eb;color:#fff;border:none;border-radius:4px;cursor:pointer;width:100%">Carregar de URL</button>
    </div>
    
    <div style="margin:15px 0">
      <label style="display:block;font-size:12px;margin-bottom:5px"><b>📂 Importar ficheiro JSON:</b></label>
      <input id="fileInput" type="file" accept=".json" style="width:100%;padding:8px;background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:4px;box-sizing:border-box;font-size:12px;cursor:pointer">
      <button id="btnLoadFile" style="margin-top:8px;padding:8px 12px;background:#2563eb;color:#fff;border:none;border-radius:4px;cursor:pointer;width:100%">Importar ficheiro</button>
    </div>
    
    <button id="btnCloseSource" style="margin-top:15px;padding:8px 12px;background:#475569;color:#fff;border:none;border-radius:4px;cursor:pointer;width:100%">Fechar</button>
  </div>
</div>

<div id="archiveTooltip" style="display:none;position:fixed;top:50px;right:20px;background:#1e293b;color:#e2e8f0;border-radius:6px;border:1px solid #334155;box-shadow:0 4px 16px rgba(0,0,0,0.8);z-index:3000;overflow:hidden">
  <div style="background:#0f172a;padding:8px 12px;border-bottom:1px solid #334155;font-size:12px;font-weight:500">📊 Estatísticas</div>
  <div style="padding:12px 16px;white-space:pre-line;font-size:12px;line-height:1.5"><span id="archiveTooltipContent">info</span></div>
</div>

<div class="main">
  <div class="wrap" id="wrap"><svg id="svg" xmlns="http://www.w3.org/2000/svg"></svg>
    <div class="empty" id="empty" style="display:none"></div>
  </div>
  <aside id="panel"></aside>
</div>

<script>
const NS="http://www.w3.org/2000/svg";
const svg=document.getElementById("svg"), wrap=document.getElementById("wrap"), panel=document.getElementById("panel");
const NODE_W=210, NODE_H=64;

const CAT_COLOR={filiacao:"#2563eb",casamento:"#db2777",irmandade:"#059669",afinidade:"#d97706",padrinho:"#0891b2",heranca:"#7c3aed",descendencia:"#7c3aed",compra:"#dc2626",venda:"#dc2626",hipoteca:"#0f766e",outro:"#6b7280"};
const CAT_LABEL={filiacao:"Filhos",casamento:"Casados",irmandade:"Irmãos",afinidade:"Afinidade",padrinho:"Padrinhos",heranca:"Heranças",descendencia:"Descendência inferida",venda:"Vendas",hipoteca:"Hipoteca",outro:"Outro"};

const norm=s=>(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/\s+/g," ").trim();
const clean=s=>(s||"").replace(/\([^)]*\)/g," ").replace(/\[[^\]]*\]/g," ").replace(/\s+/g," ").trim();
const esc=s=>(s||"").replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c]));
const SEXO_F=/\b(filha|mae|mulher|esposa|irma|madrinha|viuva|sogra|nora|afilhada|divorciada|inventariada|solteira)\b/;
const SEXO_M=/\b(filho|pai|marido|esposo|irmao|padrinho|viuvo|sogro|genro|afilhado|divorciado|inventariado|solteiro)\b/;
function inferSexo(p, rels){ if(p.sexo){ const s=(p.sexo||"").toUpperCase(); return s[0]==="F"?"F":s[0]==="M"?"M":""; }
  const txt=norm((p.papel||"")+" "+(rels||[]).map(r=>r.relacao).join(" "));
  if(SEXO_F.test(txt)) return "F"; if(SEXO_M.test(txt)) return "M"; return ""; }
const SEXO_FILL={F:"#fdf2f8",M:"#eff6ff","":"#fff"};
// relação inversa: quando a pessoa vista é o ALVO (para), descrever da perspetiva dela.
// S = sexo da pessoa vista; otherS = sexo do outro. Preserva nuance de divórcio/viuvez.
function inverseRel(cat, relacaoText, S, otherS){
  const g=(f,m,n)=>S==="F"?f:S==="M"?m:n; const rl=norm(relacaoText||"");
  switch(cat){
    case "filiacao": return g("mãe de","pai de","progenitor(a) de");
    case "descendencia": return "ascendente de";
    case "casamento":
      if(/divorc/.test(rl)) return g("divorciada de","divorciado de","divorciad@ de");
      if(/vi[uú]v/.test(rl)) return g("viúva de","viúvo de","viúv@ de");
      return g("casada com","casado com","casad@ com");
    case "irmandade": return g("irmã de","irmão de","irmão/irmã de");
    case "afinidade":
      if(/genro|nora/.test(rl)) return g("sogra de","sogro de","sogro(a) de");
      if(/sogr/.test(rl)) return otherS==="F"?"nora de":otherS==="M"?"genro de":"genro/nora de";
      if(/cunhad/.test(rl)) return g("cunhada de","cunhado de","cunhad@ de");
      return relacaoText;
    case "padrinho":
      if(/padrinho|madrinha/.test(rl)) return g("afilhada de","afilhado de","afilhad@ de");
      if(/afilhad/.test(rl)) return g("madrinha de","padrinho de","padrinho/madrinha de");
      return relacaoText;
    case "heranca":
      if(/coh?erdeir/.test(rl)) return g("coerdeira de","coerdeiro de","coerdeiro(a) de");
      return "deixou herança a";
    default: return relacaoText;
  }
}
// concordância de género na relação do lado direto (sujeito), preservando a restante frase
function genderRel(txt, S){ if(!S||!txt) return txt;
  const pairs=[["filho","filha"],["irmão","irmã"],["casado","casada"],["divorciado","divorciada"],["viúvo","viúva"],["herdeiro","herdeira"],["coerdeiro","coerdeira"],["padrinho","madrinha"],["afilhado","afilhada"],["genro","nora"],["sogro","sogra"],["cunhado","cunhada"]];
  for(const [m,f] of pairs){ const re=new RegExp("\\b("+m+"|"+f+")\\b","i"); if(re.test(txt)) return txt.replace(re, S==="F"?f:m); }
  return txt;
}

let DATA=null, MODEL=null, nameToId={}, view="gen", focusId=null;
const hidden=new Set();            // categorias escondidas
let isoSet=new Set();              // nós isolados ou com transacionais hidden
const posGen={}, posProp={}, posDoc={};   // posições por vista
const rowYs=[];                    // linhas-guia (genealogia)

// links (piclaw serve o workspace por HTTP; abrir em nova tab)
const RAW=p=>`/workspace/raw?path=${encodeURIComponent(p)}&download=1`;
const imgUrl=img=>RAW("cotimos/fotos/"+img);
const jsonUrl=img=>RAW("cotimos/transcricoes/imagens/"+img.replace(/\.jpg$/i,".json"));
function openImageViewer(imgPath, allImages=[], currentIdx=0){
  const modal=document.createElement("div");
  modal.style.cssText="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);z-index:2000;display:flex;align-items:stretch;justify-content:flex-start;flex-direction:row;padding:20px;gap:20px";
  
  // Container esquerdo (imagem)
  const leftContainer=document.createElement("div");
  leftContainer.style.cssText="flex:1;display:flex;flex-direction:column;gap:10px;min-width:0;position:relative";
  
  // Container direito (transcription) - overlay no canto superior direito da imagem
  const rightContainer=document.createElement("div");
  rightContainer.style.cssText="position:absolute;top:10px;right:10px;width:280px;background:#1e293b;border:1px solid #334155;border-radius:6px;padding:12px;max-height:calc(100% - 100px);display:flex;flex-direction:column;gap:10px;overflow-y:auto;z-index:10";
  rightContainer.id="transcriptionPanel";
  
  // Header com detalhes do documento
  const docDetailsHeader=document.createElement("div");
  docDetailsHeader.style.cssText="font-size:11px;color:#cbd5e1;line-height:1.5;padding-bottom:0";
  docDetailsHeader.id="docDetailsHeader";
  rightContainer.appendChild(docDetailsHeader);
  
  // Header transcription
  const transcriptHeader=document.createElement("div");
  transcriptHeader.style.cssText="display:none";  // Escondido pois já está em updateDocDetailsHeader
  transcriptHeader.textContent="📝 Transcrição";
  rightContainer.appendChild(transcriptHeader);
  
  // Content transcription
  const transcriptContent=document.createElement("div");
  transcriptContent.style.cssText="font-size:11px;color:#cbd5e1;white-space:pre-wrap;line-height:1.4;overflow-y:auto;flex:1";
  transcriptContent.id="transcriptContent";
  transcriptContent.textContent="Carregando...";
  rightContainer.appendChild(transcriptContent);
  
  leftContainer.appendChild(rightContainer);
  modal.appendChild(leftContainer);
  
  let scale=1, panX=0, panY=0, isDragging=false, startX=0, startY=0, startPanX=0, startPanY=0;
  let showTranscription=true;
  let currentImage=imgPath;
  let currentIndex=currentIdx;
  
  const img=document.createElement("img");
  img.src=imgUrl(currentImage);
  img.style.cssText="max-width:100%;max-height:calc(100% - 60px);object-fit:contain;cursor:grab;user-select:none";
  
  const viewer=document.createElement("div");
  viewer.style.cssText="width:100%;height:calc(100% - 60px);overflow:hidden;display:flex;align-items:center;justify-content:center;position:relative";
  viewer.appendChild(img);
  
  const controls=document.createElement("div");
  controls.style.cssText="flex-shrink:0;height:50px;display:flex;gap:12px;justify-content:center;align-items:center;padding:10px 20px;background:rgba(0,0,0,0.6);border-top:1px solid #334155;width:100%";
  
  // Container para botões centrais
  const centerButtons=document.createElement("div");
  centerButtons.style.cssText="display:flex;gap:12px;justify-content:center;align-items:center;flex:1";
  
  // Container para botões direita
  const rightButtons=document.createElement("div");
  rightButtons.style.cssText="display:flex;gap:8px;align-items:center";
  
  const btnPrev=document.createElement("button");
  btnPrev.textContent="◀ Anterior";
  btnPrev.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer;opacity:0.5";
  btnPrev.disabled=true;
  if(allImages.length>1) btnPrev.disabled=currentIdx<=0;
  if(!btnPrev.disabled) btnPrev.style.opacity="1";
  
  btnPrev.onclick=async ()=>{
    if(currentIndex>0){
      currentIndex--;
      currentImage=allImages[currentIndex];
      img.src=imgUrl(currentImage);
      const transcriptTxt = await loadTranscriptionForImage(currentImage);
      updateDocDetailsHeader(currentImage);
      document.getElementById("transcriptContent").textContent = transcriptTxt;
      scale=1; panX=0; panY=0; updateTransform();
      btnPrev.disabled=currentIndex<=0;
      btnNext.disabled=currentIndex>=allImages.length-1;
      btnPrev.style.opacity=btnPrev.disabled?"0.5":"1";
      btnNext.style.opacity=btnNext.disabled?"0.5":"1";
    }
  };
  
  const btnNext=document.createElement("button");
  btnNext.textContent="Próxima ▶";
  btnNext.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer;opacity:0.5";
  btnNext.disabled=true;
  if(allImages.length>1) btnNext.disabled=currentIdx>=allImages.length-1;
  if(!btnNext.disabled) btnNext.style.opacity="1";
  
  btnNext.onclick=async ()=>{
    if(currentIndex<allImages.length-1){
      currentIndex++;
      currentImage=allImages[currentIndex];
      img.src=imgUrl(currentImage);
      const transcriptTxt = await loadTranscriptionForImage(currentImage);
      updateDocDetailsHeader(currentImage);
      document.getElementById("transcriptContent").textContent = transcriptTxt;
      scale=1; panX=0; panY=0; updateTransform();
      btnPrev.disabled=currentIndex<=0;
      btnNext.disabled=currentIndex>=allImages.length-1;
      btnPrev.style.opacity=btnPrev.disabled?"0.5":"1";
      btnNext.style.opacity=btnNext.disabled?"0.5":"1";
    }
  };
  
  const btnZoomIn=document.createElement("button");
  btnZoomIn.textContent="+ Zoom";
  btnZoomIn.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer";
  btnZoomIn.onclick=()=>{ scale=Math.min(scale+0.5,50); updateTransform(); };
  
  const btnZoomOut=document.createElement("button");
  btnZoomOut.textContent="- Zoom";
  btnZoomOut.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer";
  btnZoomOut.onclick=()=>{ scale=Math.max(scale-0.5,0.5); updateTransform(); };
  
  const btnReset=document.createElement("button");
  btnReset.textContent="↺ Reset";
  btnReset.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer";
  btnReset.onclick=()=>{ scale=1; panX=0; panY=0; updateTransform(); };
  
  const btnDownload=document.createElement("button");
  btnDownload.textContent="Download ⭳";
  btnDownload.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer";
  btnDownload.onclick=()=>{ 
    const a=document.createElement("a");
    a.href=imgUrl(currentImage);
    a.download=currentImage;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };
  
  const btnClose=document.createElement("button");
  btnClose.textContent="Fechar ✕";
  btnClose.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#333;color:#fff;cursor:pointer";
  btnClose.onclick=()=>{ modal.remove(); };
  
  // Botão de toggle transcription
  const btnTranscript=document.createElement("button");
  btnTranscript.textContent="📝";
  btnTranscript.title="Toggle Transcription";
  btnTranscript.style.cssText="padding:8px 12px;border:1px solid #ccc;border-radius:4px;background:#555;color:#fff;cursor:pointer";
  btnTranscript.onclick=()=>{
    showTranscription=!showTranscription;
    rightContainer.style.display=showTranscription?"flex":"none";
    btnTranscript.style.background=showTranscription?"#555":"#333";
  };
  // Botões centrais
  centerButtons.appendChild(btnPrev);
  centerButtons.appendChild(btnNext);
  centerButtons.appendChild(btnZoomIn);
  centerButtons.appendChild(btnZoomOut);
  centerButtons.appendChild(btnReset);
  centerButtons.appendChild(btnDownload);
  
  // Botões direita
  rightButtons.appendChild(btnTranscript);
  rightButtons.appendChild(btnClose);
  
  // Adicionar ao controls
  controls.appendChild(centerButtons);
  controls.appendChild(rightButtons);
  
  leftContainer.appendChild(viewer);
  // rightContainer é overlay dentro de leftContainer
  leftContainer.appendChild(controls);  // Controls como position:absolute no meio
  
  const updateTransform=()=>{ img.style.transform=`scale(${scale}) translate(${panX}px, ${panY}px)`; };
  
  const isImageVisible=()=>{
    const imgRect=img.getBoundingClientRect();
    const viewerRect=viewer.getBoundingClientRect();
    return !(imgRect.right < viewerRect.left || imgRect.left > viewerRect.right || 
             imgRect.bottom < viewerRect.top || imgRect.top > viewerRect.bottom);
  };
  
  const clampPan=()=>{
    if(!img.naturalWidth) return;
    const scaledW=img.naturalWidth*scale;
    const scaledH=img.naturalHeight*scale;
    const viewW=viewer.clientWidth;
    const viewH=viewer.clientHeight;
    
    if(scaledW<=viewW){
      panX=0;
    } else {
      const maxPan=(scaledW-viewW)/2;
      panX=Math.max(-maxPan, Math.min(maxPan, panX));
    }
    
    if(scaledH<=viewH){
      panY=0;
    } else {
      const maxPan=(scaledH-viewH)/2;
      panY=Math.max(-maxPan, Math.min(maxPan, panY));
    }
  };
  
  const startDrag=(e)=>{ 
    if(e.button!==0) return;
    if(!img.naturalWidth) return;
    isDragging=true; 
    startX=e.clientX; 
    startY=e.clientY; 
    startPanX=panX; 
    startPanY=panY; 
    img.style.cursor="grabbing"; 
    e.preventDefault(); 
  };
  
  const onMouseMove=(e)=>{ 
    if(isDragging){ 
      const dx=e.clientX-startX;
      const dy=e.clientY-startY;
      panX=startPanX+dx/scale;
      panY=startPanY+dy/scale;
      clampPan();
      updateTransform(); 
    } 
  };
  
  const onMouseUp=()=>{ 
    isDragging=false; 
    img.style.cursor="grab"; 
  };
  
  img.onmousedown=startDrag;
  viewer.onmousedown=(e)=>{ if(isImageVisible()) startDrag(e); };
  
  document.addEventListener("mousemove", onMouseMove);
  document.addEventListener("mouseup", onMouseUp);
  
  const onWheel=(e)=>{ 
    e.preventDefault(); 
    scale+=(e.deltaY>0?-0.1:0.1); 
    scale=Math.max(0.5,Math.min(scale,50)); 
    updateTransform(); 
  };
  
  img.onwheel=onWheel;
  viewer.onwheel=onWheel;
  modal.onwheel=onWheel;
  
  modal.appendChild(leftContainer);
  modal.appendChild(rightContainer);
  document.body.appendChild(modal);
  
  // Carregar transcrição inicial
  (async () => {
    const transcriptTxt = await loadTranscriptionForImage(currentImage);
    updateDocDetailsHeader(currentImage);
    document.getElementById("transcriptContent").textContent = transcriptTxt;
  })();
}


function openJsonViewer(imgPath){
  const jsonPath=jsonUrl(imgPath);
  fetch(jsonPath).then(r=>r.text()).then(txt=>{
    const modal=document.createElement("div");
    modal.style.cssText="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px";
    
    const box=document.createElement("div");
    box.style.cssText="background:white;border-radius:8px;padding:20px;max-width:90%;max-height:90%;overflow:auto;position:relative;box-shadow:0 4px 20px rgba(0,0,0,0.3)";
    
    const btnClose=document.createElement("button");
    btnClose.textContent="Fechar ✕";
    btnClose.style.cssText="position:absolute;top:10px;right:10px;padding:5px 10px;border:1px solid #ccc;border-radius:4px;background:#f5f5f5;cursor:pointer";
    btnClose.onclick=()=>{ modal.remove(); };
    
    const title=document.createElement("h3");
    title.textContent=imgPath;
    title.style.cssText="margin-top:0";
    
    const pre=document.createElement("pre");
    pre.textContent=txt;
    pre.style.cssText="white-space:pre-wrap;font-family:monospace;font-size:0.85em;overflow:auto;max-height:70vh";
    
    box.appendChild(btnClose);
    box.appendChild(title);
    box.appendChild(pre);
    modal.appendChild(box);
    modal.onclick=(e)=>{ if(e.target===modal) modal.remove(); };
    document.body.appendChild(modal);
  }).catch(err=>alert("Erro ao carregar JSON: "+err.message));
}


function docSrcLinks(d){ 
  const imgs=(d.fontes||[]).map(f=>f.imagem).filter(f=>f&&/\.jpg$/i.test(f));
  let html='';
  (d.fontes||[]).forEach((f,idx)=>{
    if(!f.imagem||!/\.jpg$/i.test(f.imagem)) return;
    const imgEsc=esc(f.imagem).replace(/'/g,"\\'");
    const argsStr=imgs.map((img,i)=>"'"+esc(img).replace(/'/g,"\\'")+"'").join(",");
    html+=`<div class="k">${esc(f.imagem)} - <a href="javascript:void(0)" onclick="openImageViewer('${imgEsc}',[${argsStr}],${idx})" title="Ver imagem">🖼️</a> <a href="javascript:openJsonViewer('${imgEsc}')" title="Ver JSON">📋</a></div>`;
  });
  return html || `<div class="k">-</div>`;
}
function row(k,v){ return v?`<div><span class="k">${k}:</span> ${esc(v)}</div>`:""; }
// bloco de documento + links (JSON/imagem) + resumo OCR expansível
function docDetails(d){ if(!d) return "";
  const tipo=d.tipo_documento?esc(d.tipo_documento)+": ":"";  
  const obs=(d.ocr_metadata?.observacoes||"");
  const transcr=docFullTranscription(d);
  const fontes=docSrcLinks(d);
  const imgLinks = (d.fontes || []).map(f => f.imagem).filter(f => f && /\.jpg$/i.test(f));
  const imageIconHtml = imgLinks.length > 0 
    ? `<span class="img-link-icon" data-first="${esc(imgLinks[0])}" data-images="${imgLinks.map(esc).join('|')}" style="cursor:pointer;font-size:1.2em;margin-left:6px;user-select:none" title="${imgLinks.length} imagens">🔍</span>`
    : "";
  const head=`<b>${esc(d.id)}</b>${imageIconHtml} — ${tipo}${esc((d.titulo||"").slice(0,110))} <span class="k">📅 ${esc((d.data_documento||[]).join("; "))}</span>`;
  let html=`<details class="docsrc"><summary>${head}</summary><div class="srcbox">`;
  if(transcr) html+=`<h4 style="margin-top:0;font-weight:600;cursor:pointer;user-select:none"><span data-expand="▶">&#9656;</span> Transcrição Integral</h4><div class="k" style="padding:8px;margin-top:8px;background:#f9fafb;border-radius:2px;white-space:pre-wrap;font-family:monospace;font-size:0.85em;overflow-y:auto;display:none" data-transcr data-content="${esc(transcr)}"><div style="display:flex;gap:6px;margin-bottom:8px"><button class="btn" style="flex:1;padding:4px 8px;font-size:0.8em" data-copy>Copiar</button><button class="btn" style="flex:1;padding:4px 8px;font-size:0.8em" data-fullscreen>Expandir</button></div>${esc(transcr)}</div>`;
  if(obs) html+=`<h4 style="margin-top:8px;font-weight:600;cursor:pointer;user-select:none"><span data-expand="▶">&#9656;</span> Resumo OCR</h4><div class="k" style="padding:6px;margin-top:8px;background:#f9fafb;border-radius:2px;display:none" data-obs data-content="${esc(obs)}"><div style="display:flex;gap:6px;margin-bottom:8px"><button class="btn" style="flex:1;padding:4px 8px;font-size:0.8em" data-copy>Copiar</button><button class="btn" style="flex:1;padding:4px 8px;font-size:0.8em" data-fullscreen>Expandir</button></div>${esc(obs)}</div>`;
  html+=`<h4 style="margin-top:8px;font-weight:600;cursor:pointer;user-select:none"><span data-expand="▶">&#9656;</span> Listagem de Ficheiros</h4><div style="padding:6px;margin-top:8px;background:#f9fafb;border-radius:2px;display:none" data-files>${fontes}</div>`;
  html+=`<button class="btn" style="margin-top:8px;width:100%" data-gotoDoc="DL:${d.id}">Ir para documento ↴</button>`;
  html+=`</div></details>`;
  return html; }
// cria uma aresta = traço visível (sem eventos) + traço transparente largo para hover/click
function mkEdge(gE,gHit,edges,d,color,dash,ds,wGen,arrow){
  const vis=el("path",{d,fill:"none",stroke:color,"stroke-width":wGen?2.2:2,"stroke-dasharray":dash,"pointer-events":"none"});
  if(arrow) vis.setAttribute("marker-end",`url(#arrow-${arrow})`);
  const hit=el("path",{d,fill:"none",stroke:"transparent","stroke-width":16,"pointer-events":"stroke",class:"hit"});
  for(const k in ds){ if(ds[k]!=null){ vis.dataset[k]=ds[k]; hit.dataset[k]=ds[k]; } }
  gE.appendChild(vis); gHit.appendChild(hit); edges.push(vis,hit); return vis; }

// ---------- carregar ----------
// O JSON é servido pelo piclaw em /workspace/raw?path=... (relativo à origem atual).
// Fallbacks para serviço estático simples (python -m http.server) ou file:// via HTTP.
let CURRENT_SOURCE = "documentos_logicos.json";
const CANDIDATES=[
  "/workspace/raw?path=cotimos%2Ftranscricoes%2Fdocumentos_logicos.json&download=1",
  "../../transcricoes/documentos_logicos.json",
  "documentos_logicos.json"
];

async function loadFromUrl(url){
  try {
    const r = await fetch(url);
    if(!r.ok) { alert('Erro ao carregar: ' + r.status); return null; }
    CURRENT_SOURCE = url;
    return await r.json();
  } catch(e) {
    alert('Erro: ' + e.message);
    return null;
  }
}

async function loadFromFile(file){
  try {
    const txt = await file.text();
    const data = JSON.parse(txt);
    CURRENT_SOURCE = file.name;
    return data;
  } catch(e) {
    alert('Erro ao parsear JSON: ' + e.message);
    return null;
  }
}

function updateDocDetailsHeader(imageName) {
  const docId = MODEL?.imgToDoc?.[imageName];
  const doc = docId ? MODEL?.docById?.[docId] : null;
  const header = document.getElementById("docDetailsHeader");
  if(!header) return;
  
  if(!doc) {
    header.textContent = "";
    return;
  }
  
  const tipo = doc.tipo_documento || "—";
  const data = (doc.data_documento || []).join("; ") || "—";
  const titulo = doc.titulo || "—";
  const loc = doc.localizacao?.[0] || "—";
  
  // Buscar confiança OCR da imagem específica
  let confidence = "—";
  (doc.fontes || []).forEach(f => {
    if(f.imagem === imageName) {
      confidence = f.confianca_ocr || "—";
    }
  });
  
  header.innerHTML = `<div style="margin-bottom:2px">📄 <b>${esc(docId)}</b> — ${esc(tipo)}</div><div style="margin-bottom:2px">📅 ${esc(data)}</div><div style="margin-bottom:2px">📝 ${esc(titulo)}</div><div style="margin-bottom:2px">📍 ${esc(loc)}</div><div style="margin-bottom:2px;font-size:10px;opacity:0.8">📸 ${esc(imageName)} · OCR: ${esc(confidence)}</div><div style="font-weight:500;margin-top:6px">📝 Transcrição:</div>`;
}

async function loadTranscriptionForImage(imageName) {
  try {
    // Tentar /workspace/raw primeiro (mais confiável)
    let jsonPath = `/workspace/raw?path=cotimos%2Ftranscricoes%2Fimagens%2F${imageName.replace(/\.jpg$/i, ".json")}`;
    let response = await fetch(jsonPath);
    
    // Se falhar, tentar path relativo
    if(!response.ok) {
      jsonPath = `../../transcricoes/imagens/${imageName.replace(/\.jpg$/i, ".json")}`;
      response = await fetch(jsonPath);
    }
    
    if(!response.ok) return "Transcrição não disponível";
    const data = await response.json();
    const txt = data.transcricao_integral || "Sem transcrição"; console.log("✓ Transcrição carregada para", imageName, txt.length, "chars"); return txt;
  } catch(e) {
    console.error("Erro ao carregar transcrição:", e);
    return "Erro ao carregar transcrição";
  }
}

async function load(){
  for(const u of CANDIDATES){ try{ const r=await fetch(u); if(r.ok) { CURRENT_SOURCE=u; return await r.json(); } }catch(e){} }
  return null;
}

async function reloadData(data){
  if(!data) { document.getElementById("empty").innerHTML="<b>Erro ao carregar JSON.</b>"; return; }
  document.getElementById("sourceModal").style.display="none";
  document.getElementById("empty").style.display="none";
  DATA=data; MODEL=buildModel(data); nameToId=MODEL.nameToId;
  if(data.name) {
    const archEl = document.getElementById("archiveName");
    archEl.textContent = data.name;
    const ts = data.timestamp ? new Date(data.timestamp).toLocaleString('pt-PT') : "—";
    const model = data.modelo || "—";
    const desc = data.description || "—";
    const docs = data.total_documentos_logicos || 0;
    const imgs = data.total_imagens || 0;
    
    // Atualizar conteúdo do tooltip
    const tooltipContent = document.getElementById("archiveTooltipContent");
    if(tooltipContent) {
      tooltipContent.textContent = `📄 ${docs} docs · 📸 ${imgs} imagens\n📅 ${ts}\n🤖 ${model}\n📝 ${desc}`;
    }
  }
  const g=data.genealogia||{};
  document.getElementById("stats").textContent=`${MODEL.people.length} pessoas · ${MODEL.relacoes.length} relações · ${MODEL.properties.length} propriedades`;
  document.getElementById("bar").style.display="flex";
  setView("gen");
  
  // Setup tooltip modal
  setTimeout(() => {
    const archEl = document.getElementById("archiveName");
    const tooltipModal = document.getElementById("archiveTooltip");
    const tooltipContent = document.getElementById("archiveTooltipContent");
    
    if(!archEl || !tooltipModal) {
      console.error("Elements missing:", {archEl, tooltipModal});
      return;
    }
    
    archEl.addEventListener("click", (e) => {
      e.stopPropagation();
      console.log("Archive name clicked");
      tooltipModal.style.display = tooltipModal.style.display === "none" ? "block" : "none";
    });
    
    document.addEventListener("click", (e) => {
      if(e.target !== archEl && e.target !== tooltipModal && !tooltipModal.contains(e.target)) {
        tooltipModal.style.display = "none";
      }
    });
  }, 100);
}

function buildModel(data){
  const docs=data.documentos||[];
  const totalDocs = data.total_documentos_logicos || docs.length;
  const totalImgs = data.total_imagens || 0;
  const gen=data.genealogia||{pessoas:[],relacoes:[]};
  const imgToDoc={}; docs.forEach(d=>(d.fontes||[]).forEach(f=>imgToDoc[f.imagem]=d.id));
  const docById={}; docs.forEach(d=>docById[d.id]=d);

  const people=gen.pessoas.map(p=>({...p,id:"P:"+norm(p.nome)}));
  const keysOf=p=>[p.nome,...(p.variantes||[])].map(clean).map(norm).filter(k=>k.length>3);

  people.forEach(p=>{
    const K=keysOf(p), ds=new Set();
    (p.fonte_imagens||[]).forEach(img=>{ if(imgToDoc[img]) ds.add(imgToDoc[img]); });
    docs.forEach(d=>{
      const nomes=norm((d.entidades?.nomes||[]).join(" | "));
      const tx=d.transacao?norm((d.transacao.comprador||"")+" | "+(d.transacao.vendedor||"")):"";
      if(K.some(k=>nomes.includes(k)||tx.includes(k))) ds.add(d.id);
    });
    p._docs=[...ds];
    const props=[];
    docs.forEach(d=>{ const tx=d.transacao; if(!tx) return;
      const comp=norm(tx.comprador||""), vend=norm(tx.vendedor||"");
      let role=null;
      if(K.some(k=>comp.includes(k))) role="comprou";
      else if(K.some(k=>vend.includes(k))) role="vendeu";
      if(role) (d.propriedades||[]).forEach(pr=>props.push({...pr,doc:d.id,data:(d.data_documento||[]).join("; "),role,valor_tx:tx.valor,comprador:tx.comprador||"",vendedor:tx.vendedor||""}));
    });
    p._props=props;
  });

  const properties=[];
  docs.forEach(d=>(d.propriedades||[]).forEach((pr,i)=>properties.push({
    ...pr,id:"PR:"+d.id+":"+i,doc:d.id,titulo:d.titulo,tipo:d.tipo_documento,
    data:(d.data_documento||[]).join("; "),
    comprador:d.transacao?.comprador||"",vendedor:d.transacao?.vendedor||"",natureza:d.transacao?.natureza||""
  })));
  // clusters por artigo matricial (mesma propriedade em docs diferentes)
  const artMap={};
  properties.forEach(pr=>{ const m=(pr.artigo||"").match(/^\s*(\d{1,5})\s*$/); if(m){ (artMap[m[1]]=artMap[m[1]]||[]).push(pr); }});
  const sameArtigo=Object.entries(artMap).filter(([a,l])=>new Set(l.map(x=>x.doc)).size>=2);

  const pById=Object.fromEntries(people.map(p=>[p.id,p]));
  // Cria um mapa inverso: nome normalizado -> pId, considerando variantes
  const nameToId={};
  people.forEach(p=>{
    [p.nome,...(p.variantes||[])].forEach(nm=>{
      const nk=norm(nm);
      if(nk.length>3 && !nameToId[nk]) nameToId[nk]=p.id;
    });
  });

  const relacoes=gen.relacoes.map(r=>{
    const deId = nameToId[norm(r.de)] || "P:"+norm(r.de);
    const paraId = nameToId[norm(r.para)] || "P:"+norm(r.para);
    return {...r, deId, paraId, cat:r.categoria||"outro"};
  });
  const relByDe={}; relacoes.forEach(r=>{ (relByDe[r.deId]=relByDe[r.deId]||[]).push(r); });
  people.forEach(p=>{ p._sexo=inferSexo(p, relByDe[p.id]||[]); });
  return {people,relacoes,properties,docs,docById,imgToDoc,sameArtigo,pById,nameToId,totalDocs,totalImgs};
}

// ---------- util SVG + pan/zoom ----------
const el=(t,a={})=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
function svgPt(evt){ const p=svg.createSVGPoint(); p.x=evt.clientX; p.y=evt.clientY; return p.matrixTransform(svg.getScreenCTM().inverse()); }

let VB={x:0,y:0,w:1,h:1}, curW=1, curH=1, panning=null;
function applyVB(){ svg.setAttribute("viewBox",`${VB.x} ${VB.y} ${VB.w} ${VB.h}`); }
function worldFit(W,H){ curW=W;curH=H; const pad=40,cw=wrap.clientWidth||1,ch=wrap.clientHeight||1;
  const wW=W+2*pad,wH=H+2*pad, s=Math.min(cw/wW,ch/wH), vw=cw/s, vh=ch/s;
  VB={x:-pad-(vw-wW)/2,y:-pad-(vh-wH)/2,w:vw,h:vh}; applyVB(); }
function refit(){
  // Recalcular zoom baseado nos nós VISÍVEIS (não no layout completo)
  const pos = view==="gen"?posGen:view==="doc"?posDoc:posProp;
  const visibleIds = view==="gen" ? MODEL.people.filter(p=>!isoSet.has(p.id)).map(p=>p.id) : MODEL.people.map(p=>p.id);
  if(visibleIds.length>0 && pos[visibleIds[0]]) {
    zoomTo(pos,visibleIds);
  } else {
    worldFit(curW,curH);
  }
}
function zoomTo(pos,ids){ const xs=[],ys=[]; ids.forEach(id=>{const p=pos[id]; if(p){xs.push(p.x,p.x+NODE_W);ys.push(p.y,p.y+NODE_H);}}); if(!xs.length)return;
  const minx=Math.min(...xs),maxx=Math.max(...xs),miny=Math.min(...ys),maxy=Math.max(...ys),pad=70;
  const wW=maxx-minx+2*pad,wH=maxy-miny+2*pad,cw=wrap.clientWidth||1,ch=wrap.clientHeight||1,s=Math.min(cw/wW,ch/wH),vw=cw/s,vh=ch/s;
  VB={x:minx-pad-(vw-wW)/2,y:miny-pad-(vh-wH)/2,w:vw,h:vh}; applyVB(); }
// roda do rato = zoom in/out centrado no cursor
svg.addEventListener("wheel",e=>{ e.preventDefault(); const pt=svgPt(e), f=e.deltaY<0?0.85:1.15;
  VB.x=pt.x-(pt.x-VB.x)*f; VB.y=pt.y-(pt.y-VB.y)*f; VB.w*=f; VB.h*=f; applyVB(); },{passive:false});
// pan: botão do meio (em qualquer sítio) ou botão esquerdo no fundo
svg.addEventListener("mousedown",e=>{ const hit=e.target.closest(".node")||e.target.closest("path[data-a]");
  if(e.button===1 || (e.button===0 && !hit)){ e.preventDefault(); panning={sx:e.clientX,sy:e.clientY,vx:VB.x,vy:VB.y}; svg.classList.add("panning"); } });
svg.addEventListener("auxclick",e=>{ if(e.button===1) e.preventDefault(); });
// clique numa aresta = abre a relação / documento
svg.addEventListener("click",e=>{ if(dragCtx||panning)return; const p=e.target.closest("path[data-a]"); if(p) showRelation(p); });
// hover numa aresta = etiqueta com o tipo de relação
const tip=document.createElement("div"); tip.id="tip"; document.body.appendChild(tip);
function edgeName(id){ return !id?"":id.startsWith("PR:")?(MODEL.properties.find(x=>x.id===id)?.descricao||id):id.startsWith("DL:")?id.slice(3):(MODEL.pById[id]?.nome||id.slice(2)); }
function tipText(p){ const cat=p.dataset.cat,rel=p.dataset.rel,fonte=p.dataset.fonte,estado=p.dataset.estado;
  return `${edgeName(p.dataset.a)} - ${rel||CAT_LABEL[cat]||cat} → ${edgeName(p.dataset.b)}${estado?" ("+estado+")":""}${fonte?"  ["+fonte+"]":""}`; }
svg.addEventListener("mousemove",e=>{ if(panning||dragCtx){tip.style.display="none";return;}
  const p=e.target.closest && e.target.closest("path[data-a]");
  if(p){ tip.textContent=tipText(p); tip.style.display="block"; tip.style.left=(e.clientX+14)+"px"; tip.style.top=(e.clientY+14)+"px"; }
  else tip.style.display="none"; });
svg.addEventListener("mouseleave",()=>{ tip.style.display="none"; });

// ---------- drag de nós (estado global) ----------
let curPos=null,curSnap=false,curEdges=[],dragCtx=null;
function updateEdges(){ curEdges.forEach(p=>{ const a=p.dataset.a,b=p.dataset.b; if(!curPos[a]||!curPos[b])return;
  if(view==="gen"){ p.setAttribute("d",edgePathDir(a,b)); }
  else{ const aC={x:curPos[a].x+NODE_W/2,y:curPos[a].y+NODE_H/2},bC={x:curPos[b].x+NODE_W/2,y:curPos[b].y+NODE_H/2},mx=(aC.x+bC.x)/2; p.setAttribute("d",`M ${aC.x} ${aC.y} C ${mx} ${aC.y}, ${mx} ${bC.y}, ${bC.x} ${bC.y}`);} }); }
function bindView(gN,pos,snap,edges){ curPos=pos;curSnap=snap;curEdges=edges;
  gN.addEventListener("mousedown",e=>{ if(e.button!==0)return; const g=e.target.closest(".node"); if(!g)return;
    const id=g.dataset.id,p=svgPt(e); dragCtx={id,g,dx:p.x-pos[id].x,dy:p.y-pos[id].y,moved:false,sx:e.clientX,sy:e.clientY}; g.classList.add("drag"); gN.appendChild(g); e.preventDefault(); }); }
window.addEventListener("mousemove",e=>{
  if(panning){ const s=VB.w/(wrap.clientWidth||1); VB.x=panning.vx-(e.clientX-panning.sx)*s; VB.y=panning.vy-(e.clientY-panning.sy)*s; applyVB(); return; }
  if(dragCtx){ if(!dragCtx.moved){ if(Math.hypot(e.clientX-dragCtx.sx,e.clientY-dragCtx.sy)<=4) return; dragCtx.moved=true; }
    const p=svgPt(e); curPos[dragCtx.id]={x:p.x-dragCtx.dx,y:p.y-dragCtx.dy}; dragCtx.g.setAttribute("transform",`translate(${curPos[dragCtx.id].x},${curPos[dragCtx.id].y})`); updateEdges(); }
});
window.addEventListener("mouseup",()=>{
  if(panning){ panning=null; svg.classList.remove("panning"); }
  if(dragCtx){ if(curSnap){ let best=rowYs[0],bd=1e9; rowYs.forEach(y=>{const d=Math.abs(y-curPos[dragCtx.id].y);if(d<bd){bd=d;best=y;}}); curPos[dragCtx.id].y=best; dragCtx.g.setAttribute("transform",`translate(${curPos[dragCtx.id].x},${best})`); updateEdges(); }
    dragCtx.g.classList.remove("drag"); const mv=dragCtx.moved,id=dragCtx.id; dragCtx=null; if(!mv) selectNode(id); }
});

// ---------- GENEALOGIA ----------
function computeLevels(){
  const lv={}; MODEL.people.forEach(p=>lv[p.id]=0);
  const fil=[],pair=[],her=[],venda=[],hipoteca=[]; 
  MODEL.relacoes.forEach(r=>{
    if(!MODEL.pById[r.deId]||!MODEL.pById[r.paraId]) return;
    if(r.cat==="filiacao"||r.cat==="descendencia") fil.push([r.deId,r.paraId]);
    else if(r.cat==="casamento"||r.cat==="irmandade") pair.push([r.deId,r.paraId]);
    else if(r.cat==="heranca") her.push([r.deId,r.paraId]);
    else if(r.cat==="padrinho") fil.push([r.deId,r.paraId]);  // padrinho funciona como genealogia: padrinho é acima, afilhado abaixo
    else if(r.cat==="venda") venda.push([r.deId,r.paraId]);  // de=vendedor, para=comprador
    else if(r.cat==="hipoteca") hipoteca.push([r.deId,r.paraId]);  // de=devedor, para=credor
  });
  // Falecidos ficam no nível 0 por default
  her.forEach(([herdeiro,falecido])=>{ lv[falecido]=0; });
  let changed=true;
  for(let it=0;it<MODEL.people.length+5&&changed;it++){changed=false;
    fil.forEach(([c,pa])=>{const v=(lv[pa]||0)+1; if(v>lv[c]){lv[c]=v;changed=true;}});
    pair.forEach(([a,b])=>{const m=Math.max(lv[a],lv[b]); if(lv[a]<m){lv[a]=m;changed=true;} if(lv[b]<m){lv[b]=m;changed=true;}});
    her.forEach(([herdeiro,falecido])=>{ if(lv[herdeiro]<=lv[falecido]){ lv[herdeiro]=lv[falecido]+1; changed=true; } });
  }
  // Posicionar apenas vendedores/devedores sem genealogia core: linha -1 (acima de tudo)
  // Herdeiros ficam estruturalmente ligados aos falecidos (não são movidos)
  const coreGen = new Set(['filiacao','descendencia','irmandade']);
  venda.concat(hipoteca).forEach(([tx,pair])=>{
    const temCore = MODEL.relacoes.some(r=>(r.deId===tx||r.paraId===tx)&&coreGen.has(r.cat));
    if(!temCore) lv[tx] = -1;  // vendedor/devedor isolado: linha de topo
  });
  // Posicionar apenas compradores/credores (não falecidos) que só têm transacionais: linha maxLv+1 (abaixo de tudo)
  const maxLv = Math.max(...Object.values(lv).filter(v=>v>-1));
  venda.concat(hipoteca).forEach(([tx,pair])=>{
    const temCore = MODEL.relacoes.some(r=>(r.deId===pair||r.paraId===pair)&&coreGen.has(r.cat));
    if(!temCore) lv[pair] = maxLv + 1;  // comprador/credor isolado: linha de fundo
  });
  return lv;
}
function layoutGen(){
  const lv=computeLevels();
  const rows={}; MODEL.people.forEach(p=>{(rows[lv[p.id]]=rows[lv[p.id]]||[]).push(p);});
  const GAPX=40,GAPY=45,PAD=46,COUPLE_GAP=10,SIB_GAP=28;  // Muito compacto: GAPY 45, COUPLE_GAP 10
  const nLv=Math.max(...Object.keys(rows).map(Number))+1;
  rowYs.length=0; for(let l=0;l<nLv;l++) rowYs.push(PAD+l*(NODE_H+GAPY));
  // mapas de relações
  const parents={},children={},spouses={},sibs={};
  MODEL.people.forEach(p=>{parents[p.id]=[];children[p.id]=[];spouses[p.id]=[];sibs[p.id]=[];});
  MODEL.relacoes.forEach(r=>{ if(!MODEL.pById[r.deId]||!MODEL.pById[r.paraId])return;
    // herança tratada como ligação estrutural: herdeiro (de) é "filho" do falecido (para)
    if(r.cat==="filiacao"||r.cat==="descendencia"||r.cat==="heranca"){ parents[r.deId].push(r.paraId); children[r.paraId].push(r.deId); }
    if(r.cat==="casamento"){ spouses[r.deId].push(r.paraId); spouses[r.paraId].push(r.deId); }
    if(r.cat==="irmandade"){ sibs[r.deId].push(r.paraId); sibs[r.paraId].push(r.deId); }
  });
  const levels=Object.keys(rows).map(Number).sort((a,b)=>a-b);
  // Branch tracking: paterno (esquerda) vs materno (direita)
  const branch={}; // pessoa id -> "paternal" | "maternal" | "root"
  const assignBranch=(id,b)=>{ if(!branch[id]||branch[id]==="root") branch[id]=b; };
  // Marcar raízes (nível 0)
  (rows[0]||[]).forEach(p=>assignBranch(p.id,"root"));
  // Propagar: filhos herdam ramo do pai
  for(let l=0;l<nLv-1;l++){
    (rows[l]||[]).forEach(p=>{
      const pBranch=branch[p.id]||"root";
      (children[p.id]||[]).forEach(cid=>assignBranch(cid,pBranch));
    });
  }
  // vizinhança genérica (qualquer relação) para atração que minimiza distâncias globalmente
  const allNb={}; MODEL.people.forEach(p=>allNb[p.id]=[]);
  MODEL.relacoes.forEach(r=>{ if(!MODEL.pById[r.deId]||!MODEL.pById[r.paraId])return;
    allNb[r.deId].push(r.paraId); allNb[r.paraId].push(r.deId); });
  // nós totalmente isolados: sem genealogia "core" (filiação, descendencia, irmandade, padrinho)
  // Casamento mantém visível APENAS se algum cônjuge tem descendencia/parentesco
  const coreGenealogy = new Set(['filiacao', 'descendencia', 'irmandade', 'padrinho']);
  const transactional = new Set(['venda', 'hipoteca', 'heranca']);
  isoSet=new Set(MODEL.people.filter(p=>{
    const personRels = MODEL.relacoes.filter(r=>(r.deId===p.id||r.paraId===p.id));
    if(personRels.length===0) return true;  // sem relação nenhuma
    // Tem genealogia core (filhos/pais/irmãos/padrinhos)? Não isolada
    if(personRels.some(r=>coreGenealogy.has(r.cat))) return false;
    // Tem relação transacional VISÍVEL? Não isolada
    if(personRels.some(r=>transactional.has(r.cat)&&!hidden.has(r.cat))) return false;
    // Tem casamento com alguém que tem genealogia core? Não isolada
    const spouseIds = personRels.filter(r=>r.cat==="casamento").map(r=>r.deId===p.id?r.paraId:r.deId);
    const spouseHasCore = spouseIds.some(spouseId=>MODEL.relacoes.some(r=>
      (r.deId===spouseId||r.paraId===spouseId) && coreGenealogy.has(r.cat)
    ));
    if(spouseHasCore) return false;
    // Caso contrário: isolada (casamento sem descendencia + transacionais ocultos)
    return true;
  }).map(p=>p.id));
  const order={}; levels.forEach(l=>{ order[l]=rows[l].map(p=>p.id).filter(id=>!isoSet.has(id)); });
  const posIndex=l=>{ const m={}; (order[l]||[]).forEach((id,i)=>m[id]=i); return m; };
  // ordenação baricêntrica iterativa (top-down e bottom-up) para minimizar distâncias/cruzamentos
  for(let iter=0; iter<8; iter++){
    const downward = iter%2===0;
    const seq = downward? levels : levels.slice().reverse();
    seq.forEach(l=>{
      const nbLevel = downward? l-1 : l+1;
      const idx = order[nbLevel]? posIndex(nbLevel) : null;
      const bary={};
      order[l].forEach(id=>{
        const refs = downward? parents[id] : children[id];
        const vals = idx? refs.map(r=>idx[r]).filter(v=>v!=null) : [];
        bary[id] = vals.length? vals.reduce((a,b)=>a+b,0)/vals.length : null;
      });
      const cur=order[l].slice(), oi={}; cur.forEach((id,i)=>oi[id]=i);
      cur.sort((a,b)=>{ const da=bary[a],db=bary[b];
        if(da==null||db==null) return oi[a]-oi[b];
        return da-db || oi[a]-oi[b]; });
      order[l]=cur;
    });
  }
  // adjacência de casais: mover cônjuge para o lado do parceiro (greedy)
  const gapBetween=(id,prev)=> spouses[id].includes(prev)?COUPLE_GAP : sibs[id].includes(prev)?SIB_GAP : GAPX;
  function coupleAdjacency(){
    levels.forEach(l=>{ const arr=order[l];
      for(let i=0;i<arr.length;i++){ const sp=spouses[arr[i]][0];
        if(sp!=null){ const j=arr.indexOf(sp); if(j>=0 && j!==i){ arr.splice(j,1); arr.splice(i+1,0,sp); } } }
      order[l]=arr;
    });
  }
  // Ordenação por ramo: paternal à esquerda, maternal à direita (branch-aware sorting)
  function orderByBranch(){
    levels.forEach(l=>{ const arr=order[l];
      arr.sort((a,b)=>{
        const ba=branch[a]||"root", bb=branch[b]||"root";
        if(ba==="paternal" && bb!=="paternal") return -1;  // paternal esquerda
        if(ba!=="paternal" && bb==="paternal") return 1;   // maternal direita
        return 0;  // manter ordem interna
      });
      order[l]=arr;
    });
  }
  const baseX={};
  function packX(){ // atribui X compacto por nível com gaps variáveis
    levels.forEach(l=>{ const arr=order[l]; let x=0;
      arr.forEach((id,i)=>{ if(i>0) x += NODE_W + gapBetween(id,arr[i-1]); baseX[id]=x; });
    });
  }
  // refinar X com squeeze bidirecional (centra filhos sob os pais, respeitando gaps)
  function refineX(){
    [0,1].forEach(pass=>{
      const seq = pass===0? levels : levels.slice().reverse();
      seq.forEach(l=>{ const arr=order[l]; if(!arr.length) return;
        const nbSel = pass===0? parents : children;
        const desired=arr.map(id=>{
          const strong=[...nbSel[id], ...spouses[id]].map(r=>baseX[r]).filter(v=>v!=null);
          const weak=allNb[id].map(r=>baseX[r]).filter(v=>v!=null);
          const vals=[...strong, ...strong, ...weak]; // estrutura primária 2x
          return vals.length? vals.reduce((a,b)=>a+b,0)/vals.length : baseX[id];
        });
        const gap=arr.map((id,i)=> i>0? NODE_W+gapBetween(id,arr[i-1]) : 0);
        const fx=[]; arr.forEach((id,i)=>{ fx[i]= i>0? Math.max(desired[i], fx[i-1]+gap[i]) : desired[i]; });
        const bx=[]; for(let i=arr.length-1;i>=0;i--){ bx[i]= i<arr.length-1? Math.min(desired[i], bx[i+1]-gap[i+1]) : desired[i]; }
        const x=arr.map((id,i)=>(fx[i]+bx[i])/2);
        for(let i=1;i<arr.length;i++){ if(x[i]<x[i-1]+gap[i]) x[i]=x[i-1]+gap[i]; }
        arr.forEach((id,i)=>baseX[id]=x[i]);
      });
    });
  }
  // reordenar níveis pela média da posição X dos vizinhos (capta ligações multi-nível, ex: herdeiros em níveis diferentes)
  function reorderByNeighborX(){
    levels.forEach(l=>{ const arr=order[l]; const key={}, oi={};
      arr.forEach((id,i)=>{ oi[id]=i;
        const ns=allNb[id].map(r=>baseX[r]).filter(v=>v!=null);
        key[id]= ns.length? ns.reduce((a,b)=>a+b,0)/ns.length : baseX[id];
      });
      arr.sort((a,b)=> (key[a]-key[b]) || (oi[a]-oi[b]));
      order[l]=arr;
    });
  }
  coupleAdjacency(); orderByBranch(); packX();
  for(let k=0;k<6;k++) refineX();
  // rondas de reordenação global + reflow para centrar ligações multi-nível
  for(let round=0; round<4; round++){
    reorderByNeighborX(); coupleAdjacency(); orderByBranch(); packX();
    for(let k=0;k<6;k++) refineX();
  }
  // Reposicionar apenas nós VISÍVEIS (ignorar vizinhos em isoSet no cálculo)
  levels.forEach(l=>{
    const arr = order[l];
    arr.forEach(id=>{
      const visibleNb = allNb[id].filter(nb=>!isoSet.has(nb)).map(r=>baseX[r]).filter(v=>v!=null);
      if(visibleNb.length) baseX[id] = visibleNb.reduce((a,b)=>a+b,0)/visibleNb.length;
    });
  });
  coupleAdjacency(); orderByBranch(); packX();
  for(let k=0;k<3;k++) refineX();  // aplaihar final
  // ATRAÇÃO FORTE DE CASAMENTOS: mantém cônjuges muito próximos
  levels.forEach(l=>{
    (order[l]||[]).forEach((id,i)=>{
      const sp = spouses[id]?.[0];
      if(sp && baseX[sp]!=null){
        // Puxar cônjuge muito perto (praticamente adjacente)
        const midpoint = (baseX[id]+baseX[sp])/2;
        baseX[id] = midpoint - (NODE_W + COUPLE_GAP)/2;
        baseX[sp] = midpoint + (NODE_W + COUPLE_GAP)/2;
      }
    });
  });
  // Atrair transacionais aos seus pares (vendedor→comprador, herdeiro→falecido)
  const coreGen2 = new Set(['filiacao','descendencia','irmandade']);
  const attractTx = (cat,isFrom)=>{
    MODEL.relacoes.filter(r=>r.cat===cat).forEach(r=>{
      const [tx,pair] = isFrom ? [r.deId,r.paraId] : [r.paraId,r.deId];
      if(MODEL.pById[tx]&&MODEL.pById[pair]&&baseX[tx]!=null&&baseX[pair]!=null){
        // Atrair tx em direção a pair: move 20% para perto
        const dist = baseX[pair]-baseX[tx];
        if(Math.abs(dist)>NODE_W*1.5) baseX[tx] += dist*0.15;
      }
    });
  };
  attractTx('venda',true);  // vendedor→comprador
  attractTx('hipoteca',true);  // devedor→credor
  attractTx('heranca',false);  // herdeiro←falecido
  packX();  // recompactar após atracção
  for(let k=0;k<2;k++) refineX();  // suavizar final
  // nós isolados (sem relações): colocados compactos logo à direita do cluster, evitando grandes vazios
  const visibleX = Object.values(order).flat().map(id=>baseX[id]).filter(v=>v!=null);
  if(visibleX.length){
    const maxX = Math.max(...visibleX);
    if(isoSet.size){
      let ix=maxX+NODE_W+GAPX*2;
      MODEL.people.forEach(p=>{ if(isoSet.has(p.id)){ baseX[p.id]=ix; ix += NODE_W+GAPX; } });
    }
  }
  // shift global + dimensões reais (apenas nós VISÍVEIS)
  // Recalcular rowYs com TODOS os níveis (incl. -1 e maxLv+1)
  const allLevels = [...new Set(Object.values(lv))];
  const minLv = Math.min(...allLevels), maxLv2 = Math.max(...allLevels);
  rowYs.length=0; 
  for(let l=minLv; l<=maxLv2; l++) {
    const yPos = PAD + (l-minLv)*(NODE_H+GAPY);
    rowYs[l-minLv] = yPos;  // armazenar em índice relativo
  }
  // Mapa de nível -> Y
  const lvToY = {};
  for(let l=minLv; l<=maxLv2; l++) lvToY[l] = PAD + (l-minLv)*(NODE_H+GAPY);
  
  const allX = visibleX.length>0 ? visibleX : MODEL.people.map(p=>baseX[p.id]);
  const minX=Math.min(...allX),maxX=Math.max(...allX),shift=PAD-minX;
  MODEL.people.forEach(p=>{ if(!posGen[p.id]) posGen[p.id]={x:baseX[p.id]+shift,y:lvToY[lv[p.id]]}; });
  const W=(maxX-minX)+NODE_W+2*PAD;
  // H: contar apenas níveis que tîm nós VISÍVEIS (agora pode incluir -1)
  const visibleLevels = new Set(MODEL.people.filter(p=>!isoSet.has(p.id)).map(p=>lv[p.id]));
  const nLvVis = visibleLevels.size>0? (Math.max(...visibleLevels) - Math.min(...visibleLevels) + 1) : 1;
  const H=PAD*2+nLvVis*NODE_H+(nLvVis-1)*GAPY;
  return {W,H};
}
function edgePathGen(a,b,same){
  const A=posGen[a],B=posGen[b];
  if(same){ const L=A.x<B.x?A:B,R=A.x<B.x?B:A; return `M ${L.x+NODE_W} ${L.y+NODE_H/2} L ${R.x} ${R.y+NODE_H/2}`; }
  const t=A.y<=B.y?A:B, bo=A.y<=B.y?B:A;
  const x1=t.x+NODE_W/2,y1=t.y+NODE_H,x2=bo.x+NODE_W/2,y2=bo.y,my=(y1+y2)/2;
  return `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
}
// desenha SEMPRE de a→b (respeita direção lógica; marker-end fica no destino b)
function edgePathDir(a,b){
  const A=posGen[a],B=posGen[b]; if(!A||!B) return "";
  const sameY=Math.abs(A.y-B.y)<1;
  if(sameY){
    if(A.x<=B.x) return `M ${A.x+NODE_W} ${A.y+NODE_H/2} L ${B.x} ${B.y+NODE_H/2}`;
    return `M ${A.x} ${A.y+NODE_H/2} L ${B.x+NODE_W} ${B.y+NODE_H/2}`;
  }
  const x1=A.x+NODE_W/2, x2=B.x+NODE_W/2;
  let y1,y2;
  if(A.y<B.y){ y1=A.y+NODE_H; y2=B.y; }   // a acima → sai do fundo de a, entra no topo de b
  else { y1=A.y; y2=B.y+NODE_H; }           // a abaixo → sai do topo de a, entra no fundo de b
  const my=(y1+y2)/2;
  return `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
}
function renderGen(){
  const {W,H}=layoutGen(); svg._H=H;
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.innerHTML="";
  // adicionar markers de seta
  const defs=el("defs");
  for(const [color,hex] of Object.entries({filiacao:"#2563eb",heranca:"#7c3aed",padrinho:"#0891b2",compra:"#dc2626"})){
    defs.appendChild(el("marker",{id:`arrow-${color}`,markerWidth:9,markerHeight:9,refX:9,refY:3,orient:"auto",markerUnits:"strokeWidth",viewBox:"0 0 10 6"}));
    defs.querySelector(`#arrow-${color}`).appendChild(el("path",{d:"M0,0 L0,6 L9,3 z",fill:hex}));
  }
  svg.appendChild(defs);
  const gGrid=el("g"); rowYs.forEach(y=>gGrid.appendChild(el("line",{x1:10,x2:W-10,y1:y+NODE_H/2,y2:y+NODE_H/2,class:"grid"}))); svg.appendChild(gGrid);
  const gE=el("g"), gHit=el("g"), gN=el("g"); svg.appendChild(gE); svg.appendChild(gHit); svg.appendChild(gN);

  const edges=[];
  MODEL.relacoes.forEach(r=>{
    if(hidden.has(r.cat)) return;
    if(!posGen[r.deId]||!posGen[r.paraId]) return;
    if(!posGen[r.deId].y || !posGen[r.paraId].y) return;  // pula se Y está undefined
    if(isoSet.has(r.deId)||isoSet.has(r.paraId)) return;  // pula se um nó está oculto
    const same=(r.cat==="casamento"||r.cat==="irmandade");
    const color=CAT_COLOR[r.cat]||CAT_COLOR.outro;
    const _rl=norm(r.relacao||""); const _sp=/(divorc|vi[uú]v|separ|ex-mulher|ex-marido|ex-esposa)/.test(_rl);
    const dash = _sp ? "9 4" : r.fonte==="glossario" ? "2 4" : (r.cat==="descendencia"||r.fonte==="inferido") ? "6 5" : "0";
    // Direção lógica das setas: pai→filho, falecido→herdeiro, padrinho→afilhado, vendedor→comprador
    const isGenealogical=(r.cat==="filiacao"||r.cat==="descendencia"||r.cat==="heranca");  // herdação é genealogia but inverted
    const isTransactional=(r.cat==="venda"||r.cat==="hipoteca"||r.cat==="padrinho");  // padrinho usa de→para
    const logicalArrow=isGenealogical||isTransactional?r.cat:null;
    if(logicalArrow){
      const [fromId,toId] = isGenealogical ? [r.paraId,r.deId] : [r.deId,r.paraId];  // gen: para→de, tx: de→para
      mkEdge(gE,gHit,edges,edgePathDir(fromId,toId),color,dash,{a:fromId,b:toId,cat:r.cat,fonte:r.fonte||"",rel:r.relacao||"",estado:r.estado||""},true,logicalArrow);
    } else {
      mkEdge(gE,gHit,edges,edgePathGen(r.deId,r.paraId,same),color,dash,{a:r.deId,b:r.paraId,cat:r.cat,fonte:r.fonte||"",rel:r.relacao||"",estado:r.estado||""},true,null);
    }
  });
  // Opção A: relações transacionais vêm da genealogia (categoria venda/hipoteca).
  // O bloco antigo das properties é REMOVIDO (não mais necessário).

  MODEL.people.forEach(p=>{
    if(isoSet.has(p.id)) return;  // pula nós ocultos (transacionais escondidos ou isolados)
    const {x,y}=posGen[p.id];
    const g=el("g",{class:"node",transform:`translate(${x},${y})`}); g.dataset.id=p.id;
    g.appendChild(el("rect",{width:NODE_W,height:NODE_H,rx:9,fill:SEXO_FILL[p._sexo||""]}));
    const nm=el("text",{class:"nm",x:NODE_W/2,y:19,"text-anchor":"middle"}); nm.textContent=p.nome; g.appendChild(nm);
    const pp=el("text",{class:"pp",x:NODE_W/2,y:35,"text-anchor":"middle"}); pp.textContent=(p.papel||"").slice(0,44); g.appendChild(pp);
    const vidas=[p.nascimento?"n. "+p.nascimento:"",p.obito?"†"+p.obito:""].filter(Boolean).join("  ");
    const su=el("text",{class:"su",x:NODE_W/2,y:50,"text-anchor":"middle"}); su.textContent=vidas; g.appendChild(su);
    gN.appendChild(g);
  });
  bindView(gN,posGen,true,edges);
  applyFocus();
  // Zoom automático: ajustar ao conteúdo real dos nós VISÍVEIS
  const visibleIds = MODEL.people.filter(p=>!isoSet.has(p.id)).map(p=>p.id);
  if(visibleIds.length>0){
    zoomTo(posGen,visibleIds);
  } else {
    worldFit(W,H);
  }
}

// ---------- PROPRIEDADES ----------
function layoutProp(onlyProps){
  const GAPY=20, COLW=250, PADX=40, PADY=50;
  // colunas por localização
  const locKey=pr=>norm(pr.localizacao||"-").split(",")[0].trim()||"-";
  const groups={}; MODEL.properties.forEach(pr=>{(groups[locKey(pr)]=groups[locKey(pr)]||[]).push(pr);});
  const locNames=Object.keys(groups).sort();
  // pessoas (comprador/vendedor) só se !onlyProps
  const persons=new Map();
  if(!onlyProps){ MODEL.properties.forEach(pr=>{ [pr.comprador,pr.vendedor].forEach(nm=>{ const c=clean(nm); if(c) persons.set(norm(c),c); }); }); }
  // layout: coluna 0 = vendedores, 1..n = grupos de propriedades, última = compradores
  let x=PADX, H=PADY;
  const colX={};
  const vend=[...persons.values()]; // simplificação: pessoas numa coluna à esquerda
  // esquerda: pessoas
  if(!onlyProps && vend.length){ colX.persons=x; x+=COLW+40; }
  locNames.forEach(l=>{ colX[l]=x; x+=COLW+30; });
  const W=x+PADX;
  // posicionar propriedades por grupo
  let maxY=0;
  locNames.forEach(l=>{ let y=PADY; groups[l].forEach(pr=>{ if(!posProp[pr.id]) posProp[pr.id]={x:colX[l],y}; y+=NODE_H+GAPY; }); maxY=Math.max(maxY,y); });
  // posicionar pessoas
  if(!onlyProps && vend.length){ let y=PADY; vend.forEach(nm=>{ const id="X:"+norm(nm); if(!posProp[id]) posProp[id]={x:colX.persons,y}; y+=NODE_H+GAPY; }); maxY=Math.max(maxY,y); }
  return {W,H:Math.max(maxY+PADY,300),groups,locNames,persons,colX};
}
function centerOf(id){ const p=posProp[id]; return p?{x:p.x+NODE_W/2,y:p.y+NODE_H/2}:null; }
function renderProp(){
  const onlyProps=document.getElementById("onlyProps")?.checked;
  const {W,H,persons}=layoutProp(onlyProps); svg._H=H;
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.innerHTML="";
  const gE=el("g"), gHit=el("g"), gN=el("g"); svg.appendChild(gE); svg.appendChild(gHit); svg.appendChild(gN);
  const edges=[];
  const line=(aC,bC,color,dash,ds)=>{ if(!aC||!bC)return; const mx=(aC.x+bC.x)/2;
    return mkEdge(gE,gHit,edges,`M ${aC.x} ${aC.y} C ${mx} ${aC.y}, ${mx} ${bC.y}, ${bC.x} ${bC.y}`,color,dash,ds,false); };

  if(!onlyProps){
    MODEL.properties.forEach(pr=>{
      if(hidden.has("compra")) return;
      const prC=centerOf(pr.id);
      if(pr.vendedor){ line(centerOf("X:"+norm(clean(pr.vendedor))),prC,CAT_COLOR.compra,"0",{a:"X:"+norm(clean(pr.vendedor)),b:pr.id,cat:"venda",rel:"vende",doc:pr.doc||""}); }
      if(pr.comprador){ line(prC,centerOf("X:"+norm(clean(pr.comprador))),CAT_COLOR.compra,"0",{a:pr.id,b:"X:"+norm(clean(pr.comprador)),cat:"compra",rel:"compra",doc:pr.doc||""}); }
    });
  } else {
    MODEL.sameArtigo.forEach(([art,list])=>{ for(let i=0;i<list.length;i++)for(let j=i+1;j<list.length;j++){ line(centerOf(list[i].id),centerOf(list[j].id),"#0891b2","5 4",{a:list[i].id,b:list[j].id,cat:"mesmo",rel:"mesmo arto "+art}); } });
  }
  // nós propriedade
  MODEL.properties.forEach(pr=>{
    const p=posProp[pr.id]; const g=el("g",{class:"node",transform:`translate(${p.x},${p.y})`}); g.dataset.id=pr.id;
    g.appendChild(el("rect",{width:NODE_W,height:NODE_H,rx:8,fill:"#fef9c3"}));
    const nm=el("text",{class:"nm",x:10,y:18}); nm.textContent=(pr.descricao||"").slice(0,30); g.appendChild(nm);
    const pp=el("text",{class:"pp",x:10,y:34}); pp.textContent=(pr.localizacao||"").slice(0,36); g.appendChild(pp);
    const su=el("text",{class:"su",x:10,y:49}); su.textContent=[pr.artigo?"arto "+pr.artigo:"",pr.valor||"",pr.doc].filter(Boolean).join(" · ").slice(0,40); g.appendChild(su);
    gN.appendChild(g);
  });
  // nós pessoa
  if(!onlyProps){ persons.forEach((nm)=>{ const id="X:"+norm(nm); const p=posProp[id]; if(!p)return;
    const g=el("g",{class:"node",transform:`translate(${p.x},${p.y})`}); g.dataset.id=id;
    g.appendChild(el("ellipse",{cx:NODE_W/2,cy:NODE_H/2,rx:NODE_W/2,ry:NODE_H/2-6,fill:"#dbeafe"}));
    const nm2=el("text",{class:"nm",x:NODE_W/2,y:NODE_H/2+4,"text-anchor":"middle"}); nm2.textContent=nm.slice(0,26); g.appendChild(nm2);
    gN.appendChild(g);
  }); }
  bindView(gN,posProp,false,edges);
  applyFocus();
  worldFit(W,H);
}

// ---------- foco / drilldown ----------
function neighbors(id){ const set=new Set([id]);
  if(view==="gen"){ MODEL.relacoes.forEach(r=>{ if(r.deId===id)set.add(r.paraId); if(r.paraId===id)set.add(r.deId); }); }
  else { svg.querySelectorAll("path[data-a]").forEach(p=>{ if(p.dataset.a===id)set.add(p.dataset.b); if(p.dataset.b===id)set.add(p.dataset.a); }); }
  return set;
}
function applyFocus(){
  document.getElementById("clearFocus").style.display=focusId?"":"none";
  const keep=focusId?neighbors(focusId):null;
  svg.querySelectorAll(".node").forEach(g=>{ g.classList.toggle("sel",g.dataset.id===focusId);
    g.classList.toggle("dim",!!keep&&!keep.has(g.dataset.id)); });
  svg.querySelectorAll("path[data-a]").forEach(p=>{ const on=!keep||(keep.has(p.dataset.a)&&keep.has(p.dataset.b));
    p.classList.toggle("dim",!on); });
}
function selectNode(id){ focusId=id; applyFocus(); (id.startsWith("DL:")?showDoc:id.startsWith("PR:")?showProp:showPerson)(id); }

// ---------- painel de detalhes ----------
function openPanel(html,drillId){ panel.innerHTML=`<button class="close">✕</button>`+html; panel.classList.add("show");
  
  // Listener para ícones de imagem diretos - clique não expande document
  panel.querySelectorAll(".img-link-icon").forEach(icon => {
    icon.addEventListener("click", (e) => {
      e.stopPropagation();
      e.stopImmediatePropagation();
      e.preventDefault();
      const firstImg = icon.dataset.first;
      const imagesStr = icon.dataset.images;
      const images = imagesStr ? imagesStr.split("|") : [];
      if(images.length > 0) {
        openImageViewer(firstImg, images, 0);
      }
    }, true);  // capture phase
  });
  // listeners para h4 colapsáveis e botões de transcrição/resumo
  panel.querySelectorAll("h4[style*='cursor:pointer']").forEach(h4=>{
    h4.onclick=(e)=>{
      e.preventDefault();
      const next=h4.nextElementSibling;
      if(next && (next.hasAttribute("data-transcr") || next.hasAttribute("data-obs") || next.hasAttribute("data-files"))){
        const isHidden=next.style.display==="none";
        next.style.display=isHidden?"block":"none";
        const marker=h4.querySelector("[data-expand]");
        if(marker) marker.textContent=isHidden?"▼":"▶";
      }
    };
    // botão copiar
    const copyBtn=h4.nextElementSibling?.querySelector("[data-copy]");
    if(copyBtn){
      copyBtn.onclick=(e)=>{
        e.preventDefault();
        e.stopPropagation();
        const content=h4.nextElementSibling.dataset.content;
        navigator.clipboard.writeText(content).then(()=>{
          const orig=copyBtn.textContent;
          copyBtn.textContent="Copiado!";
          setTimeout(()=>{ copyBtn.textContent=orig; },2000);
        });
      };
    }
    // botão expandir fullscreen
    const expandBtn=h4.nextElementSibling?.querySelector("[data-fullscreen]");
    if(expandBtn){
      expandBtn.onclick=(e)=>{
        e.preventDefault();
        e.stopPropagation();
        const content=h4.nextElementSibling.dataset.content;
        const title=h4.textContent.trim();
        const modal=document.createElement("div");
        modal.style.cssText=`position:fixed;top:0;left:0;width:100%;height:100%;background:#000000dd;z-index:10000;display:flex;align-items:center;justify-content:center;padding:20px`;
        modal.innerHTML=`<div style="background:#fff;width:95%;max-height:95%;border-radius:8px;display:flex;flex-direction:column;box-shadow:0 10px 40px rgba(0,0,0,0.3)">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:16px;border-bottom:1px solid #ddd;flex-shrink:0">
            <h3 style="margin:0;flex:1">${esc(title)}</h3>
            <div style="display:flex;gap:8px">
              <button style="padding:8px 16px;background:#3b82f6;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:600">Copiar Tudo</button>
              <button style="padding:8px 16px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:600">Fechar</button>
            </div>
          </div>
          <div style="flex:1;overflow-y:auto;padding:16px;background:#f9fafb;white-space:pre-wrap;font-family:monospace;font-size:0.9em;line-height:1.5;min-height:0">${esc(content)}</div>
        </div>`;
        document.body.appendChild(modal);
        const copyBtn = modal.querySelector("button:first-of-type");
        const closeBtn = modal.querySelector("button:last-of-type");
        copyBtn.onclick=()=>{
          navigator.clipboard.writeText(content).then(()=>{
            copyBtn.textContent="Copiado!";
            setTimeout(()=>{ copyBtn.textContent="Copiar Tudo"; },2000);
          }).catch(err=>console.error("Erro ao copiar:", err));
        };
        closeBtn.onclick=()=>{ modal.remove(); };
        modal.onclick=(ev)=>{ if(ev.target===modal) modal.remove(); };
      };
    }
  });
  panel.querySelector(".close").onclick=closePanel;
  const b=panel.querySelector(".btn"); if(b&&drillId) b.onclick=()=>drill(drillId); }
function closePanel(){ panel.classList.remove("show"); focusId=null; applyFocus(); }

function personByNodeId(id){ if(id.startsWith("P:")) return MODEL.pById[id];
  // pessoa da vista de propriedades (X:) → tenta casar com pessoa da genealogia
  const nm=id.slice(2); return MODEL.people.find(p=>[p.nome,...(p.variantes||[])].map(clean).map(norm).some(k=>k===nm))||{nome:nm,_props:[],_docs:[]}; }
function showPerson(id){
  const p=personByNodeId(id); const dById=MODEL.docById;
  let h=`<h2>${esc(p.nome)}</h2>`;
  if(p.papel) h+=`<div class="role">${esc(p.papel)}</div>`;
  const vidas=[p.nascimento?`n. ${p.nascimento}`:"",p.baptismo?`bapt. ${p.baptismo}`:"",p.obito?`† ${p.obito}`:""].filter(Boolean).join(" · ");
  if(vidas) h+=`<div><span class="k">Datas:</span> ${esc(vidas)}</div>`;
  if(p.variantes?.length) h+=`<div><span class="k">Variantes:</span> ${esc(p.variantes.join("; "))}</div>`;
  if(p.sexo||p._sexo) h+=`<div><span class="k">Sexo:</span> ${esc(p.sexo? (p.sexo[0].toUpperCase()==="F"?"Feminino":"Masculino") : (p._sexo==="F"?"Feminino (inferido)":"Masculino (inferido)"))}</div>`;
  if(p.alcunha) h+=`<div><span class="k">Alcunha:</span> ${esc(p.alcunha)}</div>`;
  if(p.natural) h+=`<div><span class="k">Natural:</span> ${esc(p.natural)}</div>`;
  if(p.residencia) h+=`<div><span class="k">Residência:</span> ${esc(p.residencia)}</div>`;
  if(p.profissao) h+=`<div><span class="k">Profissão:</span> ${esc(p.profissao)}</div>`;
  if(p.sepultura) h+=`<div><span class="k">Sepultura:</span> ${esc(p.sepultura)}</div>`;
  if(p.notas) h+=`<div><span class="k">Notas:</span> ${esc(p.notas)}</div>`;
  if(p.observacoes) h+=`<div><span class="k">Observações:</span> ${esc(p.observacoes)}</div>`;
  const rel=MODEL.relacoes.filter(r=>r.deId===p.id||r.paraId===p.id);
  if(rel.length){ h+=`<h3>Relações</h3><ul>`+rel.map(r=>{
    let other, dir;
    if(r.deId===p.id){ other=r.para; dir=genderRel(r.relacao, p._sexo||p.sexo||""); }
    else { other=r.de; const os=(MODEL.pById[r.deId]||{})._sexo||(MODEL.pById[r.deId]||{}).sexo||""; dir=inverseRel(r.cat,r.relacao,p._sexo||p.sexo||"",os); }
    const meta=[r.estado||"",r.local?`em ${r.local}`:"",r.data?`data ${r.data}`:"",r.valor?`valor ${r.valor}`:"",r.propriedade||"",r.notas||""].filter(Boolean).join("; ");
    return `<li>${esc(dir)} <b>${esc(other)}</b> <span class="k">[${esc(r.fonte)}]${meta?" - "+esc(meta):""}</span></li>`; }).join("")+`</ul>`; }
  if(p._props?.length){ h+=`<h3>Propriedades (compra/venda) (${p._props.length})</h3><ul>`+p._props.map(pr=>
    `<li><b>${esc(pr.role)}</b> - ${esc((pr.descricao||pr.titulo||"").slice(0,80))} <span class="k">${esc(pr.localizacao||"")}${pr.artigo?" · art. "+pr.artigo:""}</span><br/><span class="k">🛍️ ${esc(pr.vendedor||"?")}</span><br/><span class="k">🛒 ${esc(pr.comprador||"?")}</span><br/><span class="k">Data: ${esc(pr.data||"")} · Valor: ${esc(pr.valor_tx||pr.valor||"")} · Doc: ${esc(pr.doc||"")}</span></li>`).join("")+`</ul>`; }
  if(p._docs?.length){ h+=`<h3>Documentos onde aparece (${p._docs.length})</h3>`+p._docs.map(did=>docDetails(dById[did])).join(""); }
  const vendidas=p._props?.filter(pr=>pr.role==="vendeu")||[];
  h+=`<h3>Navegação</h3><div>`;
  if(vendidas.length) h+=`<button class="btn" data-drill-prop="${esc(id)}">Propriedades Vendidas (${vendidas.length}) ↴</button> `;
  h+=`<button class="btn">Ver ligações ↴</button></div>`;
  openPanel(h,id);
  const drillProp=panel.querySelector("[data-drill-prop]");
  if(drillProp) drillProp.onclick=()=>{
    const propIds=p._props.filter(pr=>pr.role==="vendeu").map(pr=>pr.id);
    setView("prop"); setTimeout(()=>{
      focusId=null; const posAll=[];
      propIds.forEach(pid=>{ if(posProp[pid]) posAll.push(...posAll, ...neighbors(pid)); });
      if(posAll.length) zoomTo(posProp,posAll); else worldFit(curW,curH);
      closePanel();
    },100);
  };
  // listeners para botões "Ir para documento"
  panel.querySelectorAll("[data-gotoDoc]").forEach(btn=>{
    btn.onclick=()=>{
      const docId=btn.getAttribute("data-gotoDoc");
      setView("doc");
      setTimeout(()=>{
        focusId=docId;
        applyFocus();
        zoomTo(posDoc,[docId]);
        showDoc(docId);
      },50);
    };
  });
}
function showProp(id){
  const pr=MODEL.properties.find(x=>x.id===id); if(!pr){return;}
  let h=`<h2>${esc((pr.descricao||"propriedade").slice(0,80))}</h2><div class="role">${esc(pr.tipo||"")} · ${esc(pr.doc)}</div>`;
  h+=row("Documento",`${pr.doc}${pr.titulo?" - "+pr.titulo:""}`)+row("Tipo documento",pr.tipo)+row("Data documento",pr.data);
  h+=row("Localização",pr.localizacao)+row("Freguesia",pr.freguesia)+row("Artigo",pr.artigo)+row("Natureza",pr.natureza_predial)+row("Área",pr.area)+row("Quota",pr.quota)+row("Valor",pr.valor);
  if(pr.comprador || pr.vendedor){
    h+=`<div style="background:#f3f4f6;border-left:4px solid #dc2626;padding:8px;margin:8px 0;border-radius:2px">`;
    if(pr.vendedor) h+=`<div><b style="color:#dc2626">🛍️ Vendedor:</b> ${esc(pr.vendedor)}</div>`;
    if(pr.comprador) h+=`<div style="margin-top:4px"><b style="color:#16a34a">🛒 Comprador:</b> ${esc(pr.comprador)}</div>`;
    h+=`</div>`;
  }
  h+=row("Natureza da transação",pr.natureza);
  if(pr.confrontacoes){ const c=pr.confrontacoes; const cc=["norte","sul","este","oeste"].map(k=>c[k]?`${k[0].toUpperCase()}: ${c[k]}`:"").filter(Boolean).join(" · ");
    if(cc) h+=`<h3>Confrontações</h3><div>${esc(cc)}</div>`; }
  const m=(pr.artigo||"").match(/^\s*(\d{1,5})\s*$/);
  if(m){ const cl=MODEL.sameArtigo.find(([a])=>a===m[1]);
    if(cl){ const chain=cl[1].slice().sort((a,b)=>String(a.data||"").localeCompare(String(b.data||"")));
      h+=`<h3>Transmissões (arto ${esc(m[1])})</h3><ul>`+chain.map(x=>{ const parties=[clean(x.vendedor),clean(x.comprador)].filter(Boolean).join(" → ");
        return `<li>${esc(x.data||"s/ data")} - <b>${esc(x.doc)}</b>${parties?` <span class="k">${esc(parties)}</span>`:""}${x.valor?` · ${esc(x.valor)}`:""}</li>`; }).join("")+`</ul>`; } }
  const pdoc=MODEL.docById[pr.doc]; if(pdoc){ h+=`<h3>Documentos onde aparece</h3>`+docDetails(pdoc); }
  else if(pr._fonte){ h+=`<h3>Fonte</h3><div class="k">${esc(pr._fonte)} - ${srcLinks(pr._fonte)}</div>`; }
  h+=`<button class="btn">Ver ligações ↴</button>`;
  openPanel(h,id);
}
function drill(id){ focusId=id; applyFocus(); const pos=view==="gen"?posGen:view==="doc"?posDoc:posProp; zoomTo(pos,[...neighbors(id)]); }

// Extrai transcricao_integral completa de um documento
function docFullTranscription(d){
  return d?.transcricao_integral || "";
}
function involvedPeople(d){
  const out=new Map();
  const put=(nm,role)=>{ const c=clean(nm); if(!c)return;
    const person=MODEL.people.find(p=>[p.nome,...(p.variantes||[])].map(clean).map(norm).some(k=>k===norm(c)));
    const id=person?person.id:"X:"+norm(c), name=person?person.nome:c;
    const cur=out.get(id); if(!cur || (cur.role==="aparece" && role!=="aparece")) out.set(id,{name,role}); };
  if(d.transacao){ put(d.transacao.comprador,"compra"); put(d.transacao.vendedor,"venda"); }
  MODEL.people.forEach(p=>{ if((p._docs||[]).includes(d.id)) put(p.nome,"aparece"); });
  return out;
}
function layoutDoc(){
  const rowH=NODE_H+16, PADX=40, PADY=50, COLW=NODE_W, GAP=120;
  const colPer=PADX, colDoc=colPer+COLW+GAP, colPr=colDoc+COLW+GAP;
  const docsSorted=MODEL.docs.slice().sort((a,b)=>a.id.localeCompare(b.id));
  const docY={}; let curY=PADY;
  docsSorted.forEach(d=>{ const prs=MODEL.properties.filter(x=>x.doc===d.id); const ppl=involvedPeople(d);
    const band=Math.max(1,prs.length,ppl.size); docY[d.id]=curY+(band-1)*rowH/2;
    prs.forEach((pr,i)=>{ if(!posDoc[pr.id]) posDoc[pr.id]={x:colPr,y:curY+i*rowH}; });
    curY+=band*rowH+18; });
  const allPeople=new Map();
  docsSorted.forEach(d=>involvedPeople(d).forEach((v,pid)=>{ if(!allPeople.has(pid)) allPeople.set(pid,v.name); }));
  const pY={}; allPeople.forEach((nm,pid)=>{ const ys=docsSorted.filter(d=>involvedPeople(d).has(pid)).map(d=>docY[d.id]); pY[pid]=ys.length?ys.reduce((a,b)=>a+b,0)/ys.length:PADY; });
  [...allPeople.keys()].sort((a,b)=>pY[a]-pY[b]).reduce((py,pid)=>{ const y=Math.max(pY[pid],py); if(!posDoc[pid]) posDoc[pid]={x:colPer,y}; return posDoc[pid].y+rowH; },PADY);
  docsSorted.forEach(d=>{ if(!posDoc["DL:"+d.id]) posDoc["DL:"+d.id]={x:colDoc,y:docY[d.id]}; });
  const ys=[curY,...[...allPeople.keys()].map(pid=>posDoc[pid].y+rowH)];
  return {W:colPr+COLW+PADX,H:Math.max(...ys)+PADY,docsSorted,allPeople};
}
function renderDoc(){
  const {W,H,docsSorted,allPeople}=layoutDoc(); svg._H=H;
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.innerHTML="";
  const gE=el("g"),gHit=el("g"),gN=el("g"); svg.appendChild(gE); svg.appendChild(gHit); svg.appendChild(gN);
  const edges=[];
  const C=id=>{const p=posDoc[id]; return p?{x:p.x+NODE_W/2,y:p.y+NODE_H/2}:null;};
  const link=(A,B,color,dash,a,b,cat,doc,rel)=>{ if(!A||!B||hidden.has(cat))return; const mx=(A.x+B.x)/2;
    mkEdge(gE,gHit,edges,`M ${A.x} ${A.y} C ${mx} ${A.y}, ${mx} ${B.y}, ${B.x} ${B.y}`,color,dash,{a,b,cat,doc:doc||"",rel:rel||""},false); };
  docsSorted.forEach(d=>{ const dc=C("DL:"+d.id);
    MODEL.properties.filter(x=>x.doc===d.id).forEach(pr=>link(dc,C(pr.id),"#94a3b8","0","DL:"+d.id,pr.id,"propriedade",d.id,"propriedade"));
    involvedPeople(d).forEach((v,pid)=>{ const col=v.role==="compra"?"#16a34a":v.role==="venda"?"#dc2626":"#3b82f6";
      link(C(pid),dc,col,v.role==="aparece"?"4 4":"0",pid,"DL:"+d.id,v.role,d.id,v.role); }); });
  MODEL.properties.forEach(pr=>{ const p=posDoc[pr.id]; if(!p)return; const g=el("g",{class:"node",transform:`translate(${p.x},${p.y})`}); g.dataset.id=pr.id;
    g.appendChild(el("rect",{width:NODE_W,height:NODE_H,rx:8,fill:"#fef9c3"}));
    const nm=el("text",{class:"nm",x:10,y:18}); nm.textContent=(pr.descricao||"").slice(0,30); g.appendChild(nm);
    const pp=el("text",{class:"pp",x:10,y:34}); pp.textContent=(pr.localizacao||"").slice(0,36); g.appendChild(pp);
    const su=el("text",{class:"su",x:10,y:49}); su.textContent=[pr.artigo?"arto "+pr.artigo:"",pr.valor||""].filter(Boolean).join(" · ").slice(0,40); g.appendChild(su);
    gN.appendChild(g); });
  allPeople.forEach((name,pid)=>{ const p=posDoc[pid]; if(!p)return; const g=el("g",{class:"node",transform:`translate(${p.x},${p.y})`}); g.dataset.id=pid;
    g.appendChild(el("ellipse",{cx:NODE_W/2,cy:NODE_H/2,rx:NODE_W/2,ry:NODE_H/2-6,fill:"#dbeafe"}));
    const t=el("text",{class:"nm",x:NODE_W/2,y:NODE_H/2+4,"text-anchor":"middle"}); t.textContent=name.slice(0,26); g.appendChild(t); gN.appendChild(g); });
  docsSorted.forEach(d=>{ const p=posDoc["DL:"+d.id]; if(!p)return; const g=el("g",{class:"node",transform:`translate(${p.x},${p.y})`}); g.dataset.id="DL:"+d.id;
    g.appendChild(el("rect",{width:NODE_W,height:NODE_H,rx:8,fill:"#e0e7ff"}));
    const nm=el("text",{class:"nm",x:NODE_W/2,y:18,"text-anchor":"middle"}); nm.textContent=(d.id+" - "+(d.tipo_documento||"")).slice(0,30); g.appendChild(nm);
    const pp=el("text",{class:"pp",x:NODE_W/2,y:34,"text-anchor":"middle"}); pp.textContent=(d.titulo||"").slice(0,40); g.appendChild(pp);
    const su=el("text",{class:"su",x:NODE_W/2,y:49,"text-anchor":"middle"}); su.textContent=(d.data_documento||[]).join("; ").slice(0,38); g.appendChild(su);
    gN.appendChild(g); });
  bindView(gN,posDoc,false,edges); applyFocus(); worldFit(W,H);
}
// ── menu único consolidado para documentos ──
function docMenuHandler(action, docId, btn){
  const d=MODEL.docById[docId.slice(3)];
  if(!d) return;
  
  switch(action){
    case 'explore': // explorar ligações
      if((d.propriedades||[]).length){
        setView("prop");
        focusId=docId;
        applyFocus();
        zoomTo(posDoc,[...neighbors(docId)]);
      }
      break;
    case 'viewProps': // ir para propriedades
      setView("prop");
      focusId=docId;
      applyFocus();
      zoomTo(posDoc,[...neighbors(docId)]);
      break;
    case 'copyAll': // copiar dados completos do documento
      const txt=`${d.id}\n${d.titulo}\n${d.tipo_documento}\nData: ${(d.data_documento||[]).join("; ")}\n${(d.propriedades||[]).map(p=>p.descricao).join("\n")}`;
      navigator.clipboard.writeText(txt).then(()=>{
        if(btn){ 
          const orig=btn.textContent;
          btn.textContent="✓ Copiado!";
          setTimeout(()=>btn.textContent=orig, 1500);
        }
      });
      break;
    case 'focusPerson': // foco numa pessoa (vendedor/comprador)
      const person=event.currentTarget.dataset.person;
      if(person) selectNode(person);
      break;
  }
}

function showDoc(id){
  const d=MODEL.docById[id.slice(3)]; if(!d)return;
  let h=`<h2>${esc(d.id)} - ${esc((d.titulo||"").slice(0,80))}</h2><div class="role">${esc(d.tipo_documento||"")}</div>`;
  h+=row("Data",(d.data_documento||[]).join("; "))+row("Localização",(d.localizacao||[]).join("; "))+row("Imagens",String(d.n_imagens||(d.fontes||[]).length));
  if(d.transacao){ const t=d.transacao;
    h+=`<h3>Transação</h3>`+row("Natureza",t.natureza)+row("Valor",t.valor);
    h+=`<div style="background:#f3f4f6;border-left:4px solid #dc2626;padding:8px;margin:8px 0;border-radius:2px">`;
    if(t.vendedor) h+=`<div><b style="color:#dc2626">🛍️ Vendedor:</b> <span class="docMenuLink" data-person="${nameToId[norm(t.vendedor)]||'P:'+norm(t.vendedor)}" title="clique para ir">${esc(t.vendedor)}</span></div>`;
    if(t.comprador) h+=`<div style="margin-top:4px"><b style="color:#16a34a">🛒 Comprador:</b> <span class="docMenuLink" data-person="${nameToId[norm(t.comprador)]||'P:'+norm(t.comprador)}" title="clique para ir">${esc(t.comprador)}</span></div>`;
    h+=`</div>`;
  }
  if((d.propriedades||[]).length){ h+=`<h3>Propriedades (${d.propriedades.length})</h3><ul>`+d.propriedades.map(pr=>`<li>${esc((pr.descricao||"").slice(0,50))} <span class="k">${esc(pr.localizacao||"")}</span></li>`).join("")+`</ul>`; }
  const ppl=involvedPeople(d);
  if(ppl.size){ h+=`<h3>Pessoas envolvidas</h3><ul>`+[...ppl.entries()].map(([pid,v])=>`<li><span class="docMenuLink" data-person="${pid}" title="clique para ir">${esc(v.name)}</span> <span class="k">[${esc(v.role)}]</span></li>`).join("")+`</ul>`; }
  h+=row("Notário/Tabelião",d.notario)+row("Tribunal/Cartório",d.tribunal)+row("Processo no",d.numero_processo)+row("Valor total",d.valor_total);
  const ents=(d.entidades?.nomes||[]); if(ents.length){ h+=`<h3>Entidades (${ents.length})</h3><div class="k">${esc(ents.slice(0,40).join(" · "))}</div>`; }
  h+=`<h3>Documentos onde aparece</h3>`+docDetails(d);
  h+=`<div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">`;
  h+=`<button class="btn" onclick="docMenuHandler('explore','${esc(id)}',this)">Ver ligações ↴</button>`;
  h+=`</div>`;
  openPanel(h,id);
  // event delegation para links de pessoa no menu
  panel.querySelectorAll(".docMenuLink").forEach(link=>{
    link.style.cursor="pointer";
    link.style.color="#2563eb";
    link.style.textDecoration="underline";
    link.onclick=()=>{
      const person=link.dataset.person;
      if(person) selectNode(person);
    };
  });
  // listeners para h4 colapsáveis (transcrição, OCR, files)
  panel.querySelectorAll("h4[style*='cursor:pointer']").forEach(h4=>{
    h4.onclick=(e)=>{
      e.preventDefault();
      const next=h4.nextElementSibling;
      if(next && (next.hasAttribute("data-transcr") || next.hasAttribute("data-obs") || next.hasAttribute("data-files"))){
        const isHidden=next.style.display==="none";
        next.style.display=isHidden?"block":"none";
        const marker=h4.querySelector("[data-expand]");
        if(marker) marker.textContent=isHidden?"▼":"▶";
      }
    };
    // botão copiar
    const copyBtn=h4.nextElementSibling?.querySelector("[data-copy]");
    if(copyBtn){
      copyBtn.onclick=(e)=>{
        e.preventDefault();
        e.stopPropagation();
        const content=h4.nextElementSibling.dataset.content;
        navigator.clipboard.writeText(content).then(()=>{
          const orig=copyBtn.textContent;
          copyBtn.textContent="✓ Copiado!";
          setTimeout(()=>{ copyBtn.textContent=orig; },2000);
        });
      };
    }
    // botão expandir fullscreen
    const expandBtn=h4.nextElementSibling?.querySelector("[data-fullscreen]");
    if(expandBtn){
      expandBtn.onclick=(e)=>{
        e.preventDefault();
        e.stopPropagation();
        const content=h4.nextElementSibling.dataset.content;
        const modal=document.createElement("div");
        modal.style.cssText="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px";
        modal.innerHTML=`<div style="background:white;border-radius:8px;padding:20px;max-width:90%;max-height:90%;overflow:auto;position:relative;box-shadow:0 4px 20px rgba(0,0,0,0.3)"><button style="position:absolute;top:10px;right:10px;padding:5px 10px;border:1px solid #ccc;border-radius:4px;background:#f5f5f5;cursor:pointer" onclick="this.closest('div').parentElement.remove()">Fechar ✕</button><h3 style="margin-top:0">${esc(h4.textContent.trim())}</h3><pre style="white-space:pre-wrap;font-family:monospace;font-size:0.85em;overflow:auto">${esc(content)}</pre></div>`;
        modal.onclick=(ev)=>{ if(ev.target===modal) modal.remove(); };
        document.body.appendChild(modal);
      };
    }
  });
}
function showRelation(p){
  const a=p.dataset.a,b=p.dataset.b,cat=p.dataset.cat||"outro",rel=p.dataset.rel||"",fonte=p.dataset.fonte||"",doc=p.dataset.doc||"";
  const nm=id=>!id?"":id.startsWith("PR:")?(MODEL.properties.find(x=>x.id===id)?.descricao||id):id.startsWith("DL:")?id.slice(3):(MODEL.pById[id]?.nome||id.slice(2));
  let h=`<h2>Relação</h2><div class="role">${esc(CAT_LABEL[cat]||cat)}${fonte?` · [${esc(fonte)}]`:""}</div>`;
  h+=`<div><b>${esc(nm(a))}</b> - ${esc(rel||CAT_LABEL[cat]||cat)} → <b>${esc(nm(b))}</b></div>`;
  const full=MODEL.relacoes.find(r=>r.cat===cat&&((r.deId===a&&r.paraId===b)||(r.deId===b&&r.paraId===a)));
  if(full){ const meta=[full.estado?`Estado: ${full.estado}`:"",full.local?`Local: ${full.local}`:"",full.data?`Data: ${full.data}`:"",full.valor?`Valor: ${full.valor}`:"",full.propriedade?`Propriedade: ${full.propriedade}`:"",full.notas?`Notas: ${full.notas}`:"",full.observacoes?`Obs.: ${full.observacoes}`:""].filter(Boolean);
    if(meta.length) h+=`<div class="k" style="margin-top:6px">${esc(meta.join(" · "))}</div>`; }
  const docSet=new Map();
  if(doc&&MODEL.docById[doc]) docSet.set(doc,MODEL.docById[doc]);
  (full?.fonte_imagens||[]).forEach(img=>{ const did=MODEL.imgToDoc?.[img]; if(did&&MODEL.docById[did]) docSet.set(did,MODEL.docById[did]); });
  if(docSet.size){ h+=`<h3>Documentos onde aparece (${docSet.size})</h3>`+[...docSet.values()].map(docDetails).join(""); }
  h+=`<h3>Navegação</h3><div>`;
  if(a) h+=`<button class="btn" data-see="${esc(a)}">ver ${esc((nm(a)||"").slice(0,22))}</button> `;
  if(b) h+=`<button class="btn" data-see="${esc(b)}">ver ${esc((nm(b)||"").slice(0,22))}</button> `;
  if(doc&&MODEL.docById[doc]) h+=`<button class="btn" data-openview="DL:${esc(doc)}">Abrir na vista Documentos ↴</button>`;
  h+=`</div>`;
  openPanel(h);
  panel.querySelectorAll("[data-see]").forEach(bt=>bt.onclick=()=>selectNode(bt.dataset.see));
  // menu handler para explorar documentos
  const ov=panel.querySelectorAll("[data-openview]");
  ov.forEach(btn=>btn.onclick=()=>{const fid=btn.dataset.openview; setView("doc"); focusId=fid; applyFocus(); zoomTo(posDoc,[...neighbors(fid)]);});

}

// ---------- barra / filtros ----------
function buildFilters(){
  const f=document.getElementById("filters"); f.innerHTML="";
  if(view==="doc"){ const COL={venda:"#dc2626",aparece:"#3b82f6",propriedade:"#94a3b8"},LAB={venda:"Vendas",aparece:"Pessoas",propriedade:"Propriedade"};
    ["venda","aparece","propriedade"].forEach(c=>{ const lab=document.createElement("label");
      lab.innerHTML=`<input type="checkbox" data-cat="${c}" ${hidden.has(c)?"":"checked"}/><span class="sw" style="background:${COL[c]}"></span>${LAB[c]}`;
      lab.querySelector("input").addEventListener("change",e=>{ e.target.checked?hidden.delete(c):hidden.add(c); rerender(); });
      f.appendChild(lab); }); return; }
  const cats = view==="gen"
    ? (()=>{ const all = [...new Set(MODEL.relacoes.map(r=>r.cat))]; 
             const others = all.filter(c=>!['venda','heranca','hipoteca'].includes(c));
             const transactional = all.filter(c=>['venda','heranca','hipoteca'].includes(c));
             return [...others, ...transactional]; })()  // transacionais no fim
    : ["venda"];
  cats.forEach(c=>{ const lab=document.createElement("label");
    lab.innerHTML=`<input type="checkbox" data-cat="${c}" ${hidden.has(c)?"":"checked"}/><span class="sw" style="background:${CAT_COLOR[c]||"#999"}"></span>${CAT_LABEL[c]||c}`;
    lab.querySelector("input").addEventListener("change",e=>{ e.target.checked?hidden.delete(c):hidden.add(c); rerender(); });
    f.appendChild(lab); });
  if(view==="prop"){ const lab=document.createElement("label");
    lab.innerHTML=`<input type="checkbox" id="onlyProps"/> só propriedades (liga mesma-propriedade)`;
    lab.querySelector("input").addEventListener("change",rerender); f.appendChild(lab); }
}
function rerender(){ view==="gen"?renderGen():view==="doc"?renderDoc():renderProp(); }

function setView(v){ view=v; focusId=null; closePanel();
  document.getElementById("vGen").classList.toggle("on",v==="gen");
  document.getElementById("vProp").classList.toggle("on",v==="prop");
  document.getElementById("vDoc").classList.toggle("on",v==="doc");
  document.getElementById("barHint").textContent = v==="gen"
    ? "Arraste os nós (snap por geração) · roda=zoom · botão do meio/fundo=pan · clique=detalhes · tracejado curto=glossário"
    : v==="prop"
    ? "Vermelho = compra/venda · clique numa aresta=relação/documento · roda=zoom · botão do meio/fundo=pan"
    : "Documentos ↔ propriedades/pessoas (verde=comprador, vermelho=vendedor, azul=aparece) · clique numa aresta/nó";
  hidden.clear();
  if(v==="gen") { hidden.add("venda"); hidden.add("heranca"); hidden.add("hipoteca"); }  // desactiva vendas, herança e hipoteca por defeito
  buildFilters(); rerender();
}

document.getElementById("vGen").onclick=()=>setView("gen");
document.getElementById("vProp").onclick=()=>setView("prop");
document.getElementById("vDoc").onclick=()=>setView("doc");
document.getElementById("fit").onclick=refit;
document.getElementById("clearFocus").onclick=()=>{ focusId=null; applyFocus(); refit(); };
window.addEventListener("resize",refit);

// ---------- init ----------
load().then(data=>{
  reloadData(data);
  setupSourceModal(); // Inicializar após dados carregados
}).catch(e=>{ 
  document.getElementById("sub").textContent="erro: "+e.message;
  document.getElementById("empty").style.display="block";
  document.getElementById("empty").innerHTML="<b>Não consegui carregar <code>documentos_logicos.json</code>.</b><br><br>O piclaw serve o JSON em <code>/workspace/raw?path=cotimos%2Ftranscricoes%2Fdocumentos_logicos.json&amp;download=1</code>. Abre esta página a partir do mesmo host do piclaw.<br><br>Em alternativa (serviço estático): <code>cd cotimos &amp;&amp; python3 -m http.server 8000</code> e abre <code>http://localhost:8000/skills/vista-grafos/vista_grafos.html</code>";
  setupSourceModal(); // Inicializar mesmo com erro
});



// Tooltip: hover + click toggle
setTimeout(() => {
  const archEl = document.getElementById("archiveName");
  if(!archEl) return;
  
  // Teste: adicionar conteúdo default ao tooltip
  const tooltip = archEl.querySelector(".tooltip");
  if(tooltip && !tooltip.textContent) {
    tooltip.textContent = "📄 0 docs · 📸 0 imagens\n📅 carregando...\n🤖 -\n📝 -";
  }
  
  archEl.addEventListener("mousemove", (e) => {
    const tooltip = archEl.querySelector(".tooltip");
    if(!tooltip) return;
    tooltip.style.left = (e.clientX + 10) + "px";
    tooltip.style.top = (e.clientY + 10) + "px";
  });
  
  archEl.addEventListener("click", (e) => {
    e.stopPropagation();
    archEl.classList.toggle("active");
  });
  
  document.addEventListener("click", () => {
    archEl.classList.remove("active");
  });
}, 100);

// Event listeners para modal de fonte (safe: verifica existência)
const setupSourceModal = () => {
  const modal = document.getElementById("sourceModal");
  const btnSource = document.getElementById("btnSource");
  const btnCloseSource = document.getElementById("btnCloseSource");
  const btnLoadUrl = document.getElementById("btnLoadUrl");
  const btnLoadFile = document.getElementById("btnLoadFile");
  const urlInput = document.getElementById("urlInput");
  const fileInput = document.getElementById("fileInput");
  const currentSource = document.getElementById("currentSource");
  
  if(!modal || !btnSource) return; // skip se elementos não existem
  
  btnSource.onclick = () => {
    modal.style.display = "flex";
    modal.style.alignItems = "center";
    modal.style.justifyContent = "center";
    modal.style.flexDirection = "column";
    currentSource.textContent = CURRENT_SOURCE;
  };

  btnCloseSource.onclick = () => {
    modal.style.display = "none";
  };

  btnLoadUrl.onclick = async () => {
    if(!urlInput.value.trim()) { alert("Introduz uma URL válida"); return; }
    const data = await loadFromUrl(urlInput.value.trim());
    if(data) await reloadData(data);
  };

  btnLoadFile.onclick = async () => {
    if(!fileInput.files[0]) { alert("Seleciona um ficheiro"); return; }
    const data = await loadFromFile(fileInput.files[0]);
    if(data) await reloadData(data);
  };

  modal.onclick = (e) => {
    if(e.target === modal) modal.style.display = "none";
  };
};

// Chamar após DOM estar pronto
</script>

</html>
